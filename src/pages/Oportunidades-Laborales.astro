---

import MainLayout from "../layout/MainLayout.astro";
import { getCollection } from "astro:content";

interface DatosPlaza {
  titulo: string;
  ubicacion: string;
  area: string;
  tipo: string;
  descripcion: string;
  fechaPublicacion: Date;
  activo: boolean;
}

interface Plaza {
  id: string;
  data: DatosPlaza;
}

const todasLasPlazas = (await getCollection("empleos")) as Plaza[];

const plazasOrdenadas: Plaza[] = todasLasPlazas
  .filter((item: Plaza) => item.data.activo === true)
  .sort(
    (primera: Plaza, segunda: Plaza) =>
      segunda.data.fechaPublicacion.getTime() -
      primera.data.fechaPublicacion.getTime()
  );
  
console.log("VACANTES ENCONTRADAS:", todasLasPlazas.length);
console.log("VACANTES ACTIVAS:", plazasOrdenadas.length); 
