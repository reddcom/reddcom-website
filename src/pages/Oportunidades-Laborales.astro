
---
import MainLayout from "../layout/MainLayout.astro";
import { getCollection } from "astro:content";

interface DatosPlaza {
  titulo: string;
  ubicacion: string;
  area: string;
  tipo: string;
  descripcion: string;
  fechaPublicacion: Date;
  activo: boolean;
}

interface Plaza {
  id: string;
  data: DatosPlaza;
}

const todasLasPlazas = (await getCollection("empleos")) as Plaza[];

const plazasOrdenadas: Plaza[] = todasLasPlazas
  .filter((item: Plaza) => item.data.activo === true)
  .sort(
    (primera: Plaza, segunda: Plaza) =>
      segunda.data.fechaPublicacion.getTime() -
      primera.data.fechaPublicacion.getTime()
  );
---

<MainLayout
  title="Oportunidades Laborales | Reddcom"
  description="Conoce las oportunidades laborales disponibles en Reddcom y forma parte de nuestro equipo."
>
  <main class="min-h-screen bg-[#f7f9fb] font-['Montserrat']">

    <!-- =====================================================
         HERO
    ====================================================== -->

    <section
      class="
        relative
        overflow-hidden
        px-6
        pb-20
        pt-[160px]
        md:px-8
        lg:px-12
        lg:pb-24
        lg:pt-[180px]
      "
    >

      <!-- DECORACIÓN DERECHA -->

      <div
        class="
          pointer-events-none
          absolute
          -right-[180px]
          top-[40px]
          hidden
          h-[520px]
          w-[520px]
          rounded-full
          border
          border-[#1595d3]/10
          lg:block
        "
      ></div>

      <div
        class="
          pointer-events-none
          absolute
          -right-[50px]
          top-[170px]
          hidden
          h-[280px]
          w-[280px]
          rounded-full
          border
          border-[#1595d3]/10
          lg:block
        "
      ></div>

      <div
        class="
          pointer-events-none
          absolute
          right-[150px]
          top-[250px]
          hidden
          h-[8px]
          w-[8px]
          rounded-full
          bg-[#1595d3]
          lg:block
        "
      ></div>


      <div class="relative mx-auto max-w-[1320px]">

        <!-- ETIQUETA -->

        <div class="flex items-center gap-5">

          <span
            class="
              h-[2px]
              w-[48px]
              bg-[#1595d3]
            "
          ></span>

          <span
            class="
              text-[9px]
              font-semibold
              uppercase
              tracking-[0.38em]
              text-[#102f4d]
            "
          >
            Únete a nuestro equipo
          </span>

        </div>


        <!-- CONTENIDO -->

        <div
          class="
            mt-8
            grid
            gap-12
            lg:grid-cols-[1fr_400px]
            lg:items-end
          "
        >

          <!-- IZQUIERDA -->

          <div>

           <h1
  class="
    max-w-[800px]
    text-[48px]
    font-semibold
    leading-[0.98]
    tracking-[-0.05em]
    text-[#102f4d]
    md:text-[64px]
    lg:text-[72px]
  "
>
  Tu talento puede ser parte

  <span class="block text-[#1595d3]">
    de lo que construimos.
  </span>
</h1>


            <p
              class="
                mt-7
                max-w-[620px]
                text-[14px]
                leading-[1.8]
                text-[#647486]
                md:text-[15px]
              "
            >
              En Reddcom buscamos personas comprometidas, responsables
              y dispuestas a crecer junto a un equipo que conecta
              personas, empresas y comunidades.
            </p>

          </div>


          <!-- DERECHA -->

          <div
            class="
              border-l
              border-[#102f4d]/15
              pl-7
            "
          >

            <span
              class="
                text-[9px]
                font-semibold
                uppercase
                tracking-[0.30em]
                text-[#1595d3]
              "
            >
              Talento Reddcom
            </span>


            <p
              class="
                mt-4
                text-[13px]
                leading-[1.75]
                text-[#526577]
              "
            >
              Explora nuestras oportunidades laborales y encuentra
              una posición donde puedas aportar tu experiencia,
              conocimiento y talento.
            </p>

          </div>

        </div>

      </div>

    </section>


    <!-- =====================================================
         BARRA DE ESTADO
    ====================================================== -->

    <section
      class="
        bg-[#073b68]
        px-6
        py-7
        text-white
        md:px-8
        lg:px-12
      "
    >

      <div
        class="
          mx-auto
          flex
          max-w-[1320px]
          flex-col
          gap-6
          sm:flex-row
          sm:items-center
          sm:justify-between
        "
      >

        <!-- IZQUIERDA -->

        <div class="flex items-center gap-4">

          <div
            class="
              flex
              h-[46px]
              w-[46px]
              shrink-0
              items-center
              justify-center
              rounded-full
              bg-white/10
              text-[#5bc1ed]
            "
          >

            <svg
              viewBox="0 0 24 24"
              fill="none"
              class="h-5 w-5"
            >
              <path
                d="M9 6V5C9 3.9 9.9 3 11 3H13C14.1 3 15 3.9 15 5V6"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
              />

              <rect
                x="4"
                y="6"
                width="16"
                height="14"
                rx="2"
                stroke="currentColor"
                stroke-width="1.6"
              />

              <path
                d="M4 11H20M10 11V13H14V11"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
              />
            </svg>

          </div>


          <div>

            <p
              class="
                text-[9px]
                font-semibold
                uppercase
                tracking-[0.30em]
                text-[#5bc1ed]
              "
            >
              Oportunidades laborales
            </p>

            <p
              class="
                mt-1
                text-[12px]
                text-white/60
              "
            >
              Posiciones actualmente abiertas en Reddcom.
            </p>

          </div>

        </div>


        <!-- CONTADOR -->

        <div class="flex items-center gap-4">

          <span
            class="
              text-[38px]
              font-semibold
              tracking-[-0.05em]
              text-white
            "
          >
            {plazasOrdenadas.length}
          </span>

          <span
            class="
              text-[8px]
              font-semibold
              uppercase
              leading-[1.6]
              tracking-[0.25em]
              text-white/60
            "
          >
            {
              plazasOrdenadas.length === 1
                ? "Plaza activa"
                : "Plazas activas"
