        </div>

      </div>

    </section>


    <!-- =====================================================
         VACANTES
    ====================================================== -->

    <section
      class="
        bg-white
        px-6
        py-20
        md:px-8
        lg:px-12
        lg:py-24
      "
    >

      <div class="mx-auto max-w-[1320px]">

        <!-- ENCABEZADO -->

        <div
          class="
            flex
            flex-col
            gap-6
            border-b
            border-[#102f4d]/10
            pb-8
            md:flex-row
            md:items-end
            md:justify-between
          "
        >

          <div>

            <div class="flex items-center gap-4">

              <span
                class="
                  h-[2px]
                  w-[38px]
                  bg-[#1595d3]
                "
              ></span>

              <span
                class="
                  text-[9px]
                  font-semibold
                  uppercase
                  tracking-[0.35em]
                  text-[#102f4d]
                "
              >
                Empleos
              </span>

            </div>


            <h2
              class="
                mt-5
                text-[34px]
                font-semibold
                tracking-[-0.04em]
                text-[#102f4d]
                md:text-[44px]
              "
            >
              Posiciones

              <span class="text-[#1595d3]">
                disponibles.
              </span>
            </h2>

          </div>


          <p
            class="
              max-w-[390px]
              text-[12px]
              leading-[1.7]
              text-[#647486]
            "
          >
            Conoce nuestras posiciones abiertas y encuentra la
            oportunidad que mejor se adapte a tu experiencia.
          </p>

        </div>


        <!-- =================================================
             SI HAY VACANTES
        ================================================== -->

        {
          plazasOrdenadas.length > 0 ? (

            <div
              class="
                mt-12
                grid
                gap-5
                md:grid-cols-2
                xl:grid-cols-3
              "
            >

              {
                plazasOrdenadas.map((item) => (

                  <article
                    class="
                      group
                      relative
                      flex
                      min-h-[350px]
                      flex-col
                      overflow-hidden
                      rounded-[24px]
                      border
                      border-[#102f4d]/10
                      bg-[#f9fbfc]
                      p-7

                      transition-all
                      duration-300

                      hover:-translate-y-1
                      hover:border-[#1595d3]/30
                      hover:bg-white
                      hover:shadow-[0_20px_50px_rgba(16,47,77,0.10)]

                      md:p-8
                    "
                  >

                    <!-- LÍNEA SUPERIOR -->

                    <span
                      class="
                        absolute
                        left-0
                        top-0
                        h-[3px]
                        w-0
                        bg-[#1595d3]

                        transition-all
                        duration-300

                        group-hover:w-full
                      "
                    ></span>


                    <!-- ESTADO / ÁREA -->

                    <div
                      class="
                        flex
                        items-center
                        justify-between
                        gap-4
                      "
                    >

                      <span
                        class="
                          inline-flex
                          items-center
                          gap-2
                          rounded-full
                          bg-[#e8f6fc]
                          px-3
                          py-2
                          text-[8px]
                          font-semibold
                          uppercase
                          tracking-[0.16em]
                          text-[#087fc1]
                        "
                      >

                        <span
                          class="
                            h-[6px]
                            w-[6px]
                            rounded-full
                            bg-[#1595d3]
                          "
                        ></span>

                        Activa

                      </span>


                      <span
                        class="
                          text-right
                          text-[9px]
                          font-medium
                          text-[#647486]
                        "
                      >
                        {item.data.area}
                      </span>

                    </div>


                    <!-- PUESTO -->

                    <h3
                      class="
                        mt-7
                        text-[23px]
                        font-semibold
                        leading-[1.2]
                        tracking-[-0.03em]
                        text-[#102f4d]
                      "
                    >
                      {item.data.titulo}
                    </h3>


                    <!-- DATOS -->

                    <div
                      class="
                        mt-5
                        flex
                        flex-wrap
                        gap-x-5
                        gap-y-3
                      "
                    >

                      <!-- UBICACIÓN -->

                      <span
                        class="
                          flex
                          items-center
                          gap-2
                          text-[11px]
                          text-[#647486]
                        "
                      >

                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          class="
                            h-4
                            w-4
                            shrink-0
                            text-[#1595d3]
                          "
                        >
                          <path
                            d="M20 10C20 15 12 21 12 21C12 21 4 15 4 10C4 5.6 7.6 2 12 2C16.4 2 20 5.6 20 10Z"
                            stroke="currentColor"
                            stroke-width="1.6"
                            stroke-linejoin="round"
                          />

                          <circle
                            cx="12"
                            cy="10"
                            r="2.5"
                            stroke="currentColor"
                            stroke-width="1.6"
                          />
                        </svg>

                        {item.data.ubicacion}

                      </span>


                      <!-- TIPO -->

                      <span
                        class="
                          flex
                          items-center
                          gap-2
                          text-[11px]
                          text-[#647486]
                        "
                      >

                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          class="
                            h-4
                            w-4
                            shrink-0
                            text-[#1595d3]
                          "
                        >
                          <circle
                            cx="12"
                            cy="12"
                            r="9"
                            stroke="currentColor"
                            stroke-width="1.6"
                          />

                          <path
                            d="M12 7V12L15 14"
                            stroke="currentColor"
                            stroke-width="1.6"
                            stroke-linecap="round"
                          />
                        </svg>

                        {item.data.tipo}

                      </span>

                    </div>


                    <!-- DESCRIPCIÓN -->

                    <p
                      class="
                        mt-6
                        text-[12px]
                        leading-[1.75]
                        text-[#647486]
                      "
                    >
                      {item.data.descripcion}
                    </p>


                    <!-- BOTÓN -->

                    <div class="mt-auto pt-8">

                      <a
                        href={`/oportunidades/${item.id}`}
                        class="
                          inline-flex
                          items-center
                          gap-4
                          text-[10px]
                          font-semibold
                          text-[#087fc1]
                          no-underline

                          transition-colors
                          duration-200

                          hover:text-[#102f4d]
                        "
                      >
                        Ver oportunidad

                        <span
                          class="
                            flex
                            h-7
                            w-7
                            items-center
                            justify-center
                            rounded-full
                            bg-[#e8f6fc]

                            transition-transform
                            duration-300

                            group-hover:translate-x-1
                          "
                        >
                          →
                        </span>

                      </a>

                    </div>

                  </article>

                ))
              }

            </div>

          ) : (

            <div
              class="
                relative
                mt-12
                flex
                min-h-[390px]
                flex-col
                items-center
                justify-center
                overflow-hidden
                rounded-[28px]
                border
                border-[#102f4d]/10
                bg-[#f8fafc]
                px-6
                py-16
                text-center
              "
            >

              <!-- DECORACIÓN -->

              <div
                class="
                  pointer-events-none
                  absolute
                  -right-[100px]
                  -top-[100px]
                  h-[250px]
                  w-[250px]
                  rounded-full
                  border
                  border-[#1595d3]/10
                "
              ></div>


              <div
                class="
                  pointer-events-none
                  absolute
                  -bottom-[100px]
                  -left-[100px]
                  h-[250px]
                  w-[250px]
                  rounded-full
                  border
                  border-[#1595d3]/10
                "
              ></div>


              <div
                class="
                  relative
                  z-10
                  flex
                  max-w-[520px]
                  flex-col
                  items-center
                "
              >

                <!-- ICONO -->

                <div
                  class="
                    flex
                    h-[84px]
                    w-[84px]
                    items-center
                    justify-center
                    rounded-full
                    bg-white
                    text-[#102f4d]/20
                    shadow-[0_10px_30px_rgba(16,47,77,0.06)]
                  "
                >

                  <svg
                    viewBox="0 0 64 64"
                    fill="none"
                    class="h-[50px] w-[50px]"
                  >
                    <circle
                      cx="32"
                      cy="32"
                      r="25"
                      stroke="currentColor"
                      stroke-width="4"
                    />

                    <circle
                      cx="24"
                      cy="27"
                      r="2.5"
                      fill="currentColor"
                    />

                    <circle
                      cx="40"
                      cy="27"
                      r="2.5"
                      fill="currentColor"
                    />

                    <path
                      d="M23 43C28 37 36 37 41 43"
                      stroke="currentColor"
                      stroke-width="4"
                      stroke-linecap="round"
                    />
                  </svg>

                </div>


                <span
                  class="
                    mt-7
                    text-[8px]
                    font-semibold
                    uppercase
                    tracking-[0.32em]
                    text-[#1595d3]
                  "
                >
                  Actualmente
                </span>


                <h3
                  class="
                    mt-3
                    text-[23px]
                    font-semibold
                    tracking-[-0.03em]
                    text-[#102f4d]
                    md:text-[28px]
                  "
                >
                  No hay oportunidades disponibles
                </h3>


                <p
                  class="
                    mt-3
                    max-w-[430px]
                    text-[13px]
                    leading-[1.75]
                    text-[#647486]
                  "
                >
                  En este momento no contamos con posiciones abiertas.
                  Vuelve pronto para conocer nuevas oportunidades
                  laborales en Reddcom.
                </p>


                <div
                  class="
                    mt-8
                    flex
                    items-center
                    gap-4
                  "
                >

                  <span
                    class="
                      h-[1px]
                      w-[45px]
                      bg-[#1595d3]/40
                    "
                  ></span>

                  <span
                    class="
                      text-[8px]
                      font-semibold
                      uppercase
                      tracking-[0.28em]
                      text-[#102f4d]/50
                    "
                  >
                    Reddcom
                  </span>

                  <span
                    class="
                      h-[1px]
                      w-[45px]
                      bg-[#1595d3]/40
                    "
                  ></span>

                </div>

              </div>

            </div>

          )
        }

      </div>

    </section>

<!-- =====================================================
     ENVÍO DE CV - SIEMPRE VISIBLE
====================================================== -->

<section
  class="
    bg-white
    px-6
    pb-20
    md:px-8
    lg:px-12
    lg:pb-24
  "
>
  <div
    class="
      relative
      mx-auto
      grid
      max-w-[1320px]
      overflow-hidden
      rounded-[24px]
      bg-[#073b68]
      px-8
      py-9
      shadow-[0_18px_45px_rgba(7,59,104,0.15)]

      md:px-10

      lg:grid-cols-[1fr_1px_0.9fr_auto]
      lg:items-center
      lg:gap-10
      lg:px-12
    "
  >

    <!-- DECORACIÓN DE FONDO -->

    <div
      class="
        pointer-events-none
        absolute
        -right-[90px]
        -top-[140px]
        h-[300px]
        w-[300px]
        rounded-full
        border
        border-white/10
      "
    ></div>

    <div
      class="
        pointer-events-none
        absolute
        -right-[20px]
        -top-[70px]
        h-[160px]
        w-[160px]
        rounded-full
        border
        border-white/10
      "
    ></div>


    <!-- TITULO -->

    <h2
      class="
        relative
        z-10
        max-w-[390px]
        text-[25px]
        font-semibold
        leading-[1.08]
        tracking-[-0.04em]
        text-white
        md:text-[30px]
      "
    >
      ¿No encontraste una vacante

      <span class="block text-[#65c7ef]">
        para tu perfil?
      </span>
    </h2>


    <!-- DIVISOR -->

    <div
      class="
        relative
        z-10
        hidden
        h-[52px]
        w-px
        bg-white/25
        lg:block
      "
    ></div>


    <!-- TEXTO -->

    <p
      class="
        relative
        z-10
        max-w-[360px]
        text-[12px]
        leading-[1.8]
        text-white/70
      "
    >
      Puedes enviarnos tu currículum para ser considerado
      en futuras oportunidades.
    </p>


    <!-- BOTÓN -->

    <a
      href="mailto:rrhh.auxiliart2@reddcomca.com?subject=Currículum%20-%20Oportunidades%20Laborales"
      class="
        relative
        z-10
        inline-flex
        h-[52px]
        items-center
        justify-center
        gap-6
        whitespace-nowrap
        rounded-full
        bg-[#1595d3]
        px-7
        text-[10px]
        font-semibold
        text-white
        no-underline

        transition-all
        duration-300

        hover:-translate-y-[2px]
        hover:bg-[#20a8e6]
        hover:shadow-[0_10px_30px_rgba(0,0,0,0.15)]
      "
    >
      Enviar mi CV

      <span
        class="
          flex
          h-7
          w-7
          items-center
          justify-center
          rounded-full
          bg-white
          text-[15px]
          text-[#087fc1]
        "
      >
        →
      </span>
    </a>

  </div>
</section>


  </main>
</MainLayout>