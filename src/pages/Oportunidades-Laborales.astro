---
import Foto from "../components/ui/Foto.astro";
import { BriefcaseBusiness, Clock, GraduationCap, HardHat, MapPin, Plane, Sparkles } from "@lucide/astro";
import MainLayout from "../layout/MainLayout.astro";
import HeroPagina from "../components/hero/HeroPagina.astro";
import type { DatosHero } from "../components/hero/tipos";
import BannerCta from "../components/ui/BannerCta.astro";
import EncabezadoSeccion from "../components/ui/EncabezadoSeccion.astro";
import TarjetaMuesca from "../components/ui/TarjetaMuesca.astro";
import { correoRrhhPrueba, enlaceCorreo, jornadaLegible, ubicacionDe, vacantesActivas } from "../data/empleo";
import { cierreDe, heroDe, obtenerPagina, seccion, type Tarjeta } from "../lib/cms";
// Fotos temporales de Pexels (licencia libre): se reemplazarán desde el CMS
import fotoEquipo from "../assets/pexels/equipo-taller.jpg";
import fotoOficina from "../assets/pexels/equipo-oficina.jpg";
import fotoAzotea from "../assets/pexels/tecnicos-azotea.jpg";
import fotoReunion from "../assets/pexels/ingenieros-reunion.jpg";
import fotoCielo from "../assets/pexels/torre-cielo-azul.jpg";

const vacantes = await vacantesActivas();
const areas = [...new Set(vacantes.map((vacante) => vacante.area))];

/* Datos de prueba: se muestran mientras el campo del CMS (registro `oportunidades`) esté vacío.
   Las vacantes salen siempre del módulo Vacantes. */

const heroPrueba: DatosHero = {
  tipo: "dividido",
  encabezado: {
    etiqueta: "Únete a nuestro equipo",
    titulo: "Tu talento puede ser parte",
    destacado: "de lo que construimos.",
    descripcion:
      "Buscamos personas comprometidas, responsables y con ganas de crecer junto a un equipo que conecta personas, empresas y comunidades.",
  },
  imagen: { src: fotoEquipo, alt: "Equipo de ingenieros trabajando en un taller" },
  boton: { texto: "Ver vacantes", url: "#vacantes" },
  datos: [
    { valor: `${vacantes.length} ${vacantes.length === 1 ? "plaza" : "plazas"}`, etiqueta: "Abiertas ahora" },
    { valor: "6 países", etiqueta: "donde puedes crecer con nosotros" },
    { valor: "+20", etiqueta: "años formando equipos técnicos" },
    { valor: String(areas.length), etiqueta: "áreas con vacantes" },
    { valor: "2005", etiqueta: "año de fundación" },
  ],
};

const beneficiosPrueba = {
  encabezado: { titulo: "Construyamos tu carrera", destacado: "juntos" },
  tarjetas: [
    { titulo: "Capacitación continua", texto: "Formación técnica y certificaciones de trabajo en altura.", imagen: { src: fotoReunion, alt: "" } },
    { titulo: "Crecimiento regional", texto: "Proyectos en seis países para ampliar tu experiencia.", imagen: { src: fotoAzotea, alt: "" } },
    { titulo: "Seguridad primero", texto: "Equipo de protección y protocolos en cada obra.", imagen: { src: fotoOficina, alt: "" } },
  ],
};

const listadoPrueba = {
  encabezado: {
    etiqueta: "Empleos",
    titulo: "Posiciones",
    destacado: "abiertas.",
    descripcion: "Conoce nuestras posiciones abiertas y encuentra la oportunidad que mejor se adapte a tu experiencia.",
  },
  sinVacantes: {
    titulo: "No hay vacantes disponibles",
    descripcion: "En este momento no tenemos posiciones abiertas. Vuelve pronto o envíanos tu currículum.",
  },
};

/* Contenido del CMS con respaldo campo por campo. */
const [cms, cmsDetalle] = await Promise.all([obtenerPagina("oportunidades"), obtenerPagina("detalleVacante")]);
const hero = heroDe(cms, heroPrueba);

const lecturaBeneficios = seccion(cms, "beneficios");
const beneficios = {
  encabezado: lecturaBeneficios.uno("encabezado", "encabezado") ?? beneficiosPrueba.encabezado,
  tarjetas: (lecturaBeneficios.lista("tarjetas", "tarjeta") ?? beneficiosPrueba.tarjetas) as Tarjeta[],
};

const lecturaListado = seccion(cms, "listado");
const listado = {
  encabezado: lecturaListado.uno("encabezado", "encabezado") ?? listadoPrueba.encabezado,
  sinVacantes: lecturaListado.uno("sinVacantes", "encabezado") ?? listadoPrueba.sinVacantes,
};

const correoRrhh = seccion(cmsDetalle, "postulacion").uno("correo", "texto") ?? correoRrhhPrueba;
const envioCv = cierreDe(
  cms,
  {
    titulo: "¿No encontraste",
    destacado: "tu vacante?",
    texto: "Envíanos tu currículum y te tendremos en cuenta para futuras oportunidades.",
    boton: { texto: "Enviar mi CV", url: enlaceCorreo(correoRrhh, "Currículum - Oportunidades laborales") },
    imagen: { src: fotoCielo, alt: "" },
  },
  "envioCv",
);

// Íconos por posición: el contenido viene del CMS, la forma la decide el diseño.
const iconosBeneficio = [GraduationCap, Plane, HardHat];

const formatoFecha = new Intl.DateTimeFormat("es", { day: "numeric", month: "long" });
const tonos = ["acento", "claro", "claro", "claro"] as const;
const claseFiltro =
  "rounded-full border border-navy-900/15 px-4 py-2 text-[13px] font-semibold text-navy-900 transition-colors aria-pressed:border-navy-900 aria-pressed:bg-navy-900 aria-pressed:text-white";
---

<MainLayout
  title="Oportunidades Laborales | Reddcom"
  description="Conoce las oportunidades laborales disponibles en Reddcom y forma parte de nuestro equipo."
>
  <HeroPagina {...hero} />

  <!-- =====================================================
       BENEFICIOS  (ref. Supervity "Let's build your AI workforce — together": tarjetas altas sobre fondo oscuro)
  ====================================================== -->
  <section id="beneficios" class="bg-surface px-3 py-3 font-['Montserrat'] md:px-5">
    <div class="relative isolate overflow-hidden rounded-[32px] bg-navy-950 px-6 py-16 md:px-10 lg:py-20">
      <!-- Líneas onduladas de fondo -->
      <svg aria-hidden="true" viewBox="0 0 800 400" preserveAspectRatio="none" class="absolute inset-0 -z-10 h-full w-full text-white/5">
        {
          Array.from({ length: 14 }, (_, i) => (
            <path
              d={`M0 ${120 + i * 18} C 200 ${40 + i * 18}, 400 ${220 + i * 18}, 800 ${100 + i * 18}`}
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            />
          ))
        }
      </svg>

      <div class="mx-auto grid max-w-[1240px] gap-5 lg:grid-cols-4">
        <h2
          data-anim="titulo"
          data-cms="beneficios.encabezado"
          class="text-[38px] font-semibold leading-[1.08] tracking-[-0.045em] text-white md:text-[48px]"
        >
          {beneficios.encabezado.titulo} —
          <span class="rounded-full bg-primary-300 px-3 text-navy-950">{beneficios.encabezado.destacado}</span>
        </h2>

        {
          beneficios.tarjetas.map((tarjeta, indice) => {
            const acento = indice === beneficios.tarjetas.length - 1;
            const Icono = iconosBeneficio[indice % iconosBeneficio.length];
            return (
              <article
                data-anim="revelar"
                data-cms="beneficios.tarjetas"
                class:list={[
                  "relative flex min-h-[260px] flex-col overflow-hidden rounded-[24px] p-6 lg:min-h-[380px]",
                  acento ? "bg-primary-300 text-navy-950" : "bg-white/[0.06] text-white",
                ]}
              >
                {!acento && tarjeta.imagen && (
                  <Foto
                    src={tarjeta.imagen.src}
                    alt=""
                    widths={[320, 480]}
                    sizes="280px"
                    class="absolute inset-0 -z-10 h-full w-full object-cover opacity-25 grayscale"
                  />
                )}
                <span
                  aria-hidden="true"
                  class:list={[
                    "absolute -right-8 -top-8 -z-10 size-40 rounded-full blur-2xl",
                    acento ? "bg-white/50" : "bg-primary-300/40",
                  ]}
                />
                {acento ? (
                  <Icono size={110} stroke-width={1.2} aria-hidden="true" class="mx-auto mt-6" />
                ) : (
                  <span class="flex size-10 items-center justify-center rounded-full bg-white text-navy-950">
                    <Icono size={18} aria-hidden="true" />
                  </span>
                )}
                <h3 class="mt-auto text-[20px] font-semibold">{tarjeta.titulo}</h3>
                <p class:list={["mt-2 text-[14px] leading-6", acento ? "text-navy-950/80" : "text-white/75"]}>{tarjeta.texto}</p>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- =====================================================
       VACANTES  (ref. "Our Classes": tarjetas con muesca y flecha, filtro por área)
  ====================================================== -->
  <section id="vacantes" data-vacantes class="bg-surface py-20 font-['Montserrat'] lg:py-28">
    <div class="mx-auto max-w-[1320px] px-6 md:px-8 lg:px-12">
      <EncabezadoSeccion {...listado.encabezado} alineacion="dividido" cms="listado.encabezado" />

      {
        vacantes.length > 0 ? (
          <>
            <div class="mt-10 flex flex-wrap gap-2" role="group" aria-label="Filtrar por área">
              <button type="button" data-filtro="" aria-pressed="true" class={claseFiltro}>
                Todas ({vacantes.length})
              </button>
              {areas.map((area) => (
                <button type="button" data-filtro={area} aria-pressed="false" class={claseFiltro}>
                  {area}
                </button>
              ))}
            </div>

            <ul class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
              {vacantes.map((vacante, indice) => (
                <li data-area={vacante.area}>
                  <TarjetaMuesca
                    href={`/oportunidades/${vacante.slug}`}
                    etiqueta={`Ver vacante ${vacante.titulo}`}
                    tono={tonos[indice % tonos.length]}
                    class="h-full"
                  >
                    <span class="w-fit rounded-full bg-navy-950/[0.07] px-3 py-1 text-[12px] font-semibold">
                      {vacante.area}
                    </span>
                    <h3 class="mt-6 pr-10 text-[28px] font-semibold leading-[1.05] tracking-[-0.04em]">
                      {vacante.titulo}
                    </h3>
                    <p class="mt-3 text-[14px] leading-6 opacity-75">{vacante.resumen}</p>
                    <dl class="mt-auto flex flex-wrap gap-x-5 gap-y-2 pt-8 text-[13px] opacity-80">
                      <div class="flex items-center gap-1.5">
                        <dt class="sr-only">Ubicación</dt>
                        <MapPin size={14} aria-hidden="true" />
                        <dd>{ubicacionDe(vacante)}</dd>
                      </div>
                      <div class="flex items-center gap-1.5">
                        <dt class="sr-only">Jornada</dt>
                        <BriefcaseBusiness size={14} aria-hidden="true" />
                        <dd>{jornadaLegible(vacante)}</dd>
                      </div>
                      <div class="flex items-center gap-1.5">
                        <dt class="sr-only">Publicada</dt>
                        <Clock size={14} aria-hidden="true" />
                        <dd>{formatoFecha.format(vacante.fechaPublicacion)}</dd>
                      </div>
                    </dl>
                  </TarjetaMuesca>
                </li>
              ))}
            </ul>
          </>
        ) : (
          <div class="mt-12 flex flex-col items-center rounded-[28px] bg-white px-6 py-16 text-center" data-cms="listado.sinVacantes">
            <span class="flex size-14 items-center justify-center rounded-full bg-surface-tint text-primary-700">
              <Sparkles size={22} aria-hidden="true" />
            </span>
            <h3 class="mt-6 text-[24px] font-semibold text-navy-900">{listado.sinVacantes.titulo}</h3>
            <p class="mt-2 max-w-[420px] text-[15px] leading-7 text-body">{listado.sinVacantes.descripcion}</p>
          </div>
        )
      }
    </div>
  </section>

  <BannerCta {...envioCv} seccion="envioCv" />
</MainLayout>

<script>
  // Filtro por área: oculta las vacantes de otras áreas sin recargar.
  document.addEventListener("astro:page-load", () => {
    const seccion = document.querySelector<HTMLElement>("[data-vacantes]");
    if (!seccion) return;

    const filtros = [...seccion.querySelectorAll<HTMLButtonElement>("[data-filtro]")];
    const vacantes = [...seccion.querySelectorAll<HTMLElement>("[data-area]")];

    filtros.forEach((filtro) =>
      filtro.addEventListener("click", () => {
        const area = filtro.dataset.filtro;
        filtros.forEach((otro) => otro.setAttribute("aria-pressed", String(otro === filtro)));
        vacantes.forEach((vacante) => (vacante.hidden = Boolean(area) && vacante.dataset.area !== area));
      }),
    );
  });
</script>
