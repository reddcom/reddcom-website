---
import MainLayout from "../../layout/MainLayout.astro";
---

<MainLayout
	title="Redes HFC | Reddcom"
	description="Conoce las soluciones de Reddcom para construcción, instalación y mantenimiento de redes HFC."
>

	<section
		class="
			min-h-screen
			bg-[#f7f9fb]
			px-6
			pb-24
			pt-36
			font-['Montserrat']
			md:px-8
			lg:px-12
		"
	>
		<div class="mx-auto max-w-[1320px]">

			<span
				class="
					text-[10px]
					font-semibold
					tracking-[0.32em]
					text-[#1595d3]
				"
			>
				NUESTROS SERVICIOS
			</span>

			<h1
				class="
					mt-5
					max-w-[800px]
					text-[44px]
					font-semibold
					leading-[1.05]
					tracking-[-0.04em]
					text-[#102f4d]
					md:text-[60px]
				"
			>
				Redes
				<span class="text-[#1595d3]">
					HFC.
				</span>
			</h1>

			<!-- Aquí irá el contenido de Redes HFC -->

		</div>
	</section>

</MainLayout>