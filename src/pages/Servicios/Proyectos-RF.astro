---
import Foto from "../../components/ui/Foto.astro";
import { Activity, ArrowUpRight, Antenna, Gauge, Headset, ShieldCheck, Timer, UsersRound } from "@lucide/astro";
import MainLayout from "../../layout/MainLayout.astro";
import HeroPagina from "../../components/hero/HeroPagina.astro";
import type { DatosHero } from "../../components/hero/tipos";
import { cierreDe, heroDe, obtenerPagina, seccion, type Tarjeta } from "../../lib/cms";
import BannerCta from "../../components/ui/BannerCta.astro";
import BotonPildora from "../../components/ui/BotonPildora.astro";
import EncabezadoSeccion from "../../components/ui/EncabezadoSeccion.astro";
// Fotos temporales de Pexels (licencia libre): se reemplazarán desde el CMS
import fotoNubes from "../../assets/pexels/torre-nubes.jpg";
import fotoAzotea from "../../assets/pexels/tecnicos-azotea.jpg";
import fotoContrapicado from "../../assets/pexels/torre-contrapicado.jpg";
import fotoPoste from "../../assets/pexels/poste-cielo.jpg";
import fotoReunion from "../../assets/pexels/ingenieros-reunion.jpg";
import fotoRoja from "../../assets/pexels/torre-roja.jpg";

/* Datos de prueba: se muestran mientras el campo del CMS (registro `proyectosRf`) esté vacío. */

const heroPrueba: DatosHero = {
  tipo: "carrusel",
  encabezado: {
    etiqueta: "Servicios · Proyectos RF",
    titulo: "Radiofrecuencia para",
    destacado: "redes que no se detienen.",
    descripcion:
      "Diseño, implementación y optimización de soluciones de radiofrecuencia para operadores móviles en toda Centroamérica.",
  },
  boton: { texto: "Cotizar un proyecto", url: "/contacto" },
  diapositivas: [
    { titulo: "Site survey", texto: "Levantamiento técnico de sitios", imagen: { src: fotoNubes, alt: "Antena de telefonía móvil entre nubes" } },
    { titulo: "Instalación", texto: "Antenas y equipos en azotea", imagen: { src: fotoAzotea, alt: "Técnicos instalando antenas en una azotea" } },
    { titulo: "Microonda", texto: "Enlaces punto a punto", imagen: { src: fotoContrapicado, alt: "Torre de telecomunicaciones vista desde abajo" } },
    { titulo: "Optimización", texto: "Cobertura 4G / LTE", imagen: { src: fotoPoste, alt: "Poste de telecomunicaciones bajo un cielo azul" } },
  ],
  franja: ["Site survey", "Microonda", "3G / LTE", "5G", "Drive test", "Optimización"],
};

const capacidadesPrueba = {
  encabezado: {
    etiqueta: "Soluciones",
    titulo: "Ingeniería RF de punta a punta",
    descripcion: "Acompañamos cada fase del proyecto, desde el estudio de cobertura hasta la operación de la red.",
  },
  servicios: [
    { titulo: "Diseño RF", texto: "Soluciones adaptadas a la cobertura, capacidad y desempeño de cada proyecto." },
    { titulo: "Implementación", texto: "Infraestructura RF ejecutada bajo criterios técnicos, operativos y de seguridad." },
    { titulo: "Optimización", texto: "Análisis de desempeño para mejorar cobertura, calidad y capacidad." },
    { titulo: "Soporte técnico", texto: "Acompañamiento durante la implementación y la operación de la red.", imagen: { src: fotoReunion, alt: "" } },
  ],
};

const procesoPrueba = {
  encabezado: {
    titulo: "Nuestro proceso",
    destacado: "de trabajo",
    descripcion: "Cuatro etapas con entregables claros y un responsable técnico en cada una.",
  },
  etapas: [
    { titulo: "Planificación", texto: "Evaluamos los requerimientos técnicos y definimos el alcance." },
    { titulo: "Diseño", texto: "Propuesta RF según cobertura, capacidad e infraestructura disponible." },
    { titulo: "Implementación", texto: "Ejecución de acuerdo con los parámetros técnicos establecidos." },
    { titulo: "Optimización", texto: "Verificamos el desempeño y ajustamos para mejorar la red." },
  ],
};

const ventajasPrueba = {
  encabezado: {
    titulo: "Por qué los operadores",
    destacado: "trabajan con nosotros",
    descripcion: "Cuadrillas certificadas para trabajo en altura y experiencia en contratos regionales.",
  },
  imagen: { src: fotoRoja, alt: "Técnico escalando una torre roja y blanca" },
  tarjetas: [
    { titulo: "Personal certificado", texto: "Trabajo en altura con equipo y protocolos de seguridad." },
    { titulo: "Tiempos cumplidos", texto: "Planificación por sitio y reportes de avance semanales." },
    { titulo: "Medición continua", texto: "Drive test y KPIs antes y después de cada intervención." },
  ],
};

/* Contenido del CMS con respaldo campo por campo. */
const cms = await obtenerPagina("proyectosRf");
const hero = heroDe(cms, heroPrueba);

const soluciones = seccion(cms, "capacidades");
const capacidades = {
  encabezado: soluciones.uno("encabezado", "encabezado") ?? capacidadesPrueba.encabezado,
  servicios: (soluciones.lista("servicios", "tarjeta") ?? capacidadesPrueba.servicios) as Tarjeta[],
};

const lecturaProceso = seccion(cms, "proceso");
const proceso = {
  encabezado: lecturaProceso.uno("encabezado", "encabezado") ?? procesoPrueba.encabezado,
  etapas: lecturaProceso.lista("etapas", "tarjeta") ?? procesoPrueba.etapas,
};

const lecturaVentajas = seccion(cms, "ventajas");
const ventajas = {
  encabezado: lecturaVentajas.uno("encabezado", "encabezado") ?? ventajasPrueba.encabezado,
  imagen: lecturaVentajas.uno("imagen", "imagen") ?? ventajasPrueba.imagen,
  tarjetas: lecturaVentajas.lista("tarjetas", "tarjeta") ?? ventajasPrueba.tarjetas,
};

const cierre = cierreDe(cms, { titulo: "Diseñemos la cobertura", destacado: "de tu red" });

// Íconos por posición: el contenido viene del CMS, la forma la decide el diseño.
const iconosServicio = [Antenna, ShieldCheck, Gauge, Headset];
const iconosVentaja = [UsersRound, Timer, Activity];
const etapaResaltada = 1;
---

<MainLayout
  title="Proyectos RF | Reddcom"
  description="Diseño, implementación y optimización de soluciones de radiofrecuencia para redes de telecomunicaciones."
>
  <HeroPagina {...hero} />

  <!-- =====================================================
       SOLUCIONES  (ref. Aeline "Comprehensive consulting": tarjetas blancas con ícono cuadrado)
  ====================================================== -->
  <section id="soluciones" class="bg-surface py-20 font-['Montserrat'] lg:py-28">
    <div class="mx-auto max-w-[1320px] px-6 md:px-8 lg:px-12">
      <EncabezadoSeccion {...capacidades.encabezado} alineacion="centro" cms="capacidades.encabezado" />
      <div class="mt-8 flex justify-center">
        <BotonPildora texto="Cotizar un proyecto" href="/contacto" />
      </div>

      <div class="mt-14 grid gap-3 rounded-[28px] bg-white p-3 md:grid-cols-2 lg:grid-cols-5" data-cms="capacidades.servicios">
        {
          capacidades.servicios.map((servicio, indice) => {
            const Icono = iconosServicio[indice % iconosServicio.length];
            return (
            <article
              data-anim="revelar"
              class:list={[
                "flex gap-4 rounded-[20px] bg-surface p-6 md:min-h-[260px]",
                servicio.imagen ? "lg:col-span-2" : "flex-col",
              ]}
            >
              <div class="flex flex-1 flex-col">
                <span class="flex size-9 items-center justify-center rounded-[10px] bg-primary-300 text-navy-950">
                  <Icono size={18} aria-hidden="true" />
                </span>
                <h3 class="mt-auto text-[19px] font-semibold text-navy-900">{servicio.titulo}</h3>
                <p class="mt-2 text-[13px] leading-5 text-body">{servicio.texto}</p>
              </div>
              {servicio.imagen && (
                <Foto
                  src={servicio.imagen.src}
                  alt=""
                  widths={[320, 480]}
                  sizes="220px"
                  class="hidden w-[46%] rounded-[16px] object-cover sm:block"
                />
              )}
            </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- =====================================================
       PROCESO  (ref. "Presentation Table of Content": tarjetas pequeñas + título liviano gigante)
  ====================================================== -->
  <section id="proceso" class="bg-white py-20 font-['Montserrat'] lg:py-28">
    <div class="mx-auto max-w-[1320px] px-6 md:px-8 lg:px-12">
      <ol class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4" data-cms="proceso.etapas">
        {
          proceso.etapas.map((etapa, indice) => (
            <li
              data-anim="revelar"
              class:list={[
                "rounded-[18px] p-5",
                indice === etapaResaltada ? "bg-primary-300 text-navy-950" : "bg-surface text-navy-900",
                indice % 2 === 1 && "lg:translate-y-10",
              ]}
            >
              <p class="text-[11px] font-semibold uppercase tracking-[0.14em] opacity-60">Etapa {String(indice + 1).padStart(2, "0")}</p>
              <h3 class="mt-3 text-[17px] font-semibold">{etapa.titulo}</h3>
              <p class="mt-1 text-[13px] leading-5 opacity-75">{etapa.texto}</p>
            </li>
          ))
        }
      </ol>

      <div class="mt-20 grid gap-6 lg:grid-cols-12 lg:items-end" data-cms="proceso.encabezado">
        <h2
          data-anim="titulo"
          class="text-[44px] font-normal leading-[1] tracking-[-0.045em] text-navy-950 md:text-[80px] lg:col-span-8"
        >
          {proceso.encabezado.titulo}<br /><span class="text-primary-600">{proceso.encabezado.destacado}</span>
        </h2>
        <div class="flex items-end justify-between gap-6 lg:col-span-4">
          <p class="max-w-[260px] text-[14px] leading-6 text-body">{proceso.encabezado.descripcion}</p>
          <span
            data-anim="flotar"
            class="flex size-14 shrink-0 items-center justify-center rounded-full bg-navy-950 text-primary-300"
            aria-hidden="true"
          >
            <ArrowUpRight size={22} />
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================
       VENTAJAS  (ref. "Épargner aujourd'hui": foto completa, título encima y tarjetas superpuestas)
  ====================================================== -->
  <section id="ventajas" class="bg-white px-3 pb-20 font-['Montserrat'] md:px-5 lg:pb-28">
    <div class="relative isolate overflow-hidden rounded-[32px] px-6 pb-12 pt-24 md:px-10 lg:pt-36" data-cms="ventajas.imagen">
      <Foto
        src={ventajas.imagen.src}
        alt={ventajas.imagen.alt}
        widths={[960, 1600, 2400]}
        sizes="100vw"
        data-anim="parallax"
        class="absolute inset-0 -z-10 h-full w-full scale-110 object-cover"
      />
      <div class="absolute inset-0 -z-10 bg-gradient-to-b from-navy-950/30 via-navy-950/40 to-navy-950/70"></div>

      <div class="mx-auto max-w-[760px] text-center text-white" data-cms="ventajas.encabezado">
        <h2 data-anim="titulo" class="text-[36px] font-semibold leading-[1.05] tracking-[-0.045em] md:text-[56px]">
          {ventajas.encabezado.titulo} <span class="block">{ventajas.encabezado.destacado}</span>
        </h2>
        <p class="mx-auto mt-4 max-w-[480px] text-[15px] leading-7 text-white/85">{ventajas.encabezado.descripcion}</p>
      </div>

      <div class="mx-auto mt-14 grid max-w-[1100px] gap-4 md:grid-cols-3" data-cms="ventajas.tarjetas">
        {
          ventajas.tarjetas.map((tarjeta, indice) => {
            const Icono = iconosVentaja[indice % iconosVentaja.length];
            return (
            <article data-anim="revelar" class="flex flex-col rounded-[24px] bg-white p-7 text-navy-900">
              <span class="flex size-14 items-center justify-center rounded-full bg-primary-300 text-navy-950">
                <Icono size={22} aria-hidden="true" />
              </span>
              <h3 class="mt-6 text-[22px] font-semibold leading-tight tracking-[-0.03em]">{tarjeta.titulo}</h3>
              <p class="mt-2 text-[14px] leading-6 text-body">{tarjeta.texto}</p>
              <BotonPildora texto="Saber más" href="/contacto" class="mt-6 h-10 pl-5 text-[13px]" />
            </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <BannerCta {...cierre} />
</MainLayout>
