---
import MainLayout from "../../layout/MainLayout.astro";
---

<MainLayout
  title="Reddcom Honduras | Reddcom"
  description="Conoce los proyectos y operaciones de Reddcom en Honduras."
>

  <section
    class="
      min-h-screen
      bg-[#f7f9fb]
      px-6
      pb-24
      pt-36
      font-['Montserrat']
      md:px-8
      lg:px-12
    "
  >
    <div class="mx-auto max-w-[1320px]">

      <!-- ETIQUETA -->
      <span
        class="
          text-[10px]
          font-semibold
          uppercase
          tracking-[0.32em]
          text-[#1595d3]
        "
      >
        NUESTROS PROYECTOS
      </span>

      <!-- TÍTULO -->
      <h1
        class="
          mt-5
          max-w-[850px]
          text-[44px]
          font-semibold
          leading-[1.05]
          tracking-[-0.04em]
          text-[#102f4d]
          md:text-[60px]
        "
      >
        Reddcom
        <span class="text-[#1595d3]">
          Honduras.
        </span>
      </h1>

      <!-- DESCRIPCIÓN -->
      <p
        class="
          mt-7
          max-w-[680px]
          text-[14px]
          leading-7
          text-[#526577]
          md:text-[15px]
        "
      >
        Conoce los proyectos desarrollados por Reddcom en Honduras
        y nuestra experiencia en infraestructura y redes de
        telecomunicaciones.
      </p>

      <!--
        Aquí desarrollaremos después:

        - Introducción de Reddcom Honduras
        - Proyectos realizados
        - Cobertura
        - Tipos de infraestructura
        - Redes HFC
        - Fibra óptica
        - Cifras / estadísticas
        - Galería de proyectos
      -->

    </div>
  </section>

</MainLayout>