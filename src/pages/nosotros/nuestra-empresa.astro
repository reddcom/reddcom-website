---
import MainLayout from "../../layout/MainLayout.astro";
---

<MainLayout
  title="Nuestra Empresa | Reddcom"
  description="Conoce Reddcom, nuestra experiencia y compromiso con el desarrollo de infraestructura de telecomunicaciones."
>

  <section
    class="
      min-h-screen
      bg-[#f7f9fb]
      px-6
      pb-24
      pt-36
      font-['Montserrat']
      md:px-8
      lg:px-12
    "
  >
    <div class="mx-auto max-w-[1320px]">

      <span
        class="
          text-[10px]
          font-semibold
          uppercase
          tracking-[0.32em]
          text-[#1595d3]
        "
      >
        CONOCE REDDCOM
      </span>

      <h1
        class="
          mt-5
          max-w-[850px]
          text-[44px]
          font-semibold
          leading-[1.05]
          tracking-[-0.04em]
          text-[#102f4d]
          md:text-[60px]
        "
      >
        Nuestra
        <span class="text-[#1595d3]">
          Empresa.
        </span>
      </h1>

      <p
        class="
          mt-7
          max-w-[650px]
          text-[14px]
          leading-7
          text-[#526577]
          md:text-[15px]
        "
      >
        Conoce más sobre nuestra experiencia, trayectoria y el trabajo
        que desarrollamos en el sector de las telecomunicaciones.
      </p>

      <!--
        Aquí desarrollaremos después:
        - Quiénes somos
        - Nuestra trayectoria
        - Experiencia
        - Cobertura
        - Capacidades
      -->

    </div>
  </section>

</MainLayout>