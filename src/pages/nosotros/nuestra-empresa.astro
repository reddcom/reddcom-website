---
import Foto from "../../components/ui/Foto.astro";
import { ArrowLeft, ArrowRight, MapPin } from "@lucide/astro";
import MainLayout from "../../layout/MainLayout.astro";
import HeroPagina from "../../components/hero/HeroPagina.astro";
import type { ImageMetadata } from "astro";
import type { DatosHero } from "../../components/hero/tipos";
import { cierreDe, heroDe, obtenerPagina, seccion, type Hito, type Tarjeta } from "../../lib/cms";
import BannerCta from "../../components/ui/BannerCta.astro";
import Etiqueta from "../../components/ui/Etiqueta.astro";
import EncabezadoSeccion from "../../components/ui/EncabezadoSeccion.astro";
import InsigniaGiratoria from "../../components/ui/InsigniaGiratoria.astro";
import TarjetaMuesca from "../../components/ui/TarjetaMuesca.astro";
import fotoTorreMontanas from "../../assets/Landing/reddcom-hero.png";
import mapaCentroamerica from "../../assets/nuestra-empresa/mapa-centroamerica-azul.png";
// Fotos temporales de Pexels (licencia libre): se reemplazarán desde el CMS
import fotoEscalando from "../../assets/pexels/tecnico-escalando-torre.jpg";
import fotoCables from "../../assets/pexels/cables-ethernet.jpg";
import fotoFibra from "../../assets/pexels/fibra-panel.jpg";
import fotoTegucigalpa from "../../assets/pexels/tegucigalpa-panorama.jpg";
import fotoEstadio from "../../assets/pexels/tegucigalpa-estadio.jpg";
import fotoGuatemala from "../../assets/pexels/guatemala-volcan.jpg";
import fotoContrapicado from "../../assets/pexels/torre-contrapicado.jpg";
import fotoEquipo from "../../assets/pexels/equipo-oficina.jpg";
import fotoAzotea from "../../assets/pexels/tecnicos-azotea.jpg";
import fotoIngeniero from "../../assets/pexels/ingeniero-rack.jpg";
import fotoReunion from "../../assets/pexels/ingenieros-reunion.jpg";

/* Datos de prueba: se muestran mientras el campo correspondiente del CMS
   (registro `nuestraEmpresa`) esté vacío. */

const heroPrueba: DatosHero = {
  tipo: "dividido",
  encabezado: {
    etiqueta: "Conoce Reddcom",
    titulo: "Nuestra",
    destacado: "empresa.",
    descripcion:
      "Conectamos Centroamérica con infraestructura de telecomunicaciones confiable, innovadora y sostenible desde 2005.",
  },
  imagen: { src: fotoEscalando, alt: "Técnico escalando una torre de telecomunicaciones" },
  boton: { texto: "Ver servicios", url: "/Servicios/redes-hfc" },
  datos: [
    { valor: "ISO 9001:2015", etiqueta: "Gestión de calidad certificada" },
    { valor: "6 países", etiqueta: "con operación y equipos locales" },
    { valor: "+20", etiqueta: "años de experiencia en la región" },
    { valor: "2005", etiqueta: "año de fundación en El Salvador" },
    { valor: "3", etiqueta: "líneas de negocio en el grupo" },
  ],
};

const sinAlt = (src: ImageMetadata) => ({ src, alt: "" });

const prueba = {
  introduccion: {
    encabezado: {
      etiqueta: "Nuestra historia",
      titulo: "Una trayectoria construida",
      destacado: "con experiencia y equipo propio.",
    },
    parrafos: [
      "Iniciamos operaciones en 2005 en El Salvador con la instalación y mantenimiento de redes de cobre y HFC. Desde entonces hemos incorporado nuevas tecnologías y ampliado nuestra presencia.",
      "Hoy somos un referente regional en infraestructura de telecomunicaciones, energía y soluciones digitales.",
    ],
    imagen: { src: fotoTorreMontanas, alt: "Técnico de Reddcom en lo alto de una torre, con montañas al fondo" },
    datoDestacado: { valor: "2005", etiqueta: "El inicio de nuestra historia en El Salvador" },
    lineas: ["Telecomunicaciones", "Energía solar", "Software"],
    datos: [{ valor: "6", etiqueta: "Países con operación" }],
  },
  lineaTiempo: {
    encabezado: {
      etiqueta: "Línea de tiempo",
      titulo: "De El Salvador a una",
      destacado: "operación regional.",
      descripcion: "Una historia de crecimiento continuo, impulsada por la confianza de nuestros clientes.",
    },
    hitos: [
      { anio: 2005, lugar: "El Salvador", titulo: "El comienzo", texto: "Instalación y mantenimiento de redes de cobre y HFC.", imagen: sinAlt(fotoCables) },
      { anio: 2011, lugar: "El Salvador", titulo: "Nuevas capacidades", texto: "Expansión a GPON, fibra óptica, MSAN y DSLAM.", imagen: sinAlt(fotoFibra) },
      { anio: 2013, lugar: "Honduras", titulo: "Expansión regional", texto: "Fibra óptica, site survey y enlaces de microonda.", imagen: sinAlt(fotoTegucigalpa) },
      { anio: 2015, lugar: "Guatemala", titulo: "Contrato regional", texto: "Contrato CA4: site survey, 3G/LTE, MSAN, DSLAM y microonda.", imagen: sinAlt(fotoGuatemala) },
      { anio: 2018, lugar: "Panamá y Costa Rica", titulo: "Mayor cobertura", texto: "Nuevas operaciones de site survey y contrato CA6.", imagen: sinAlt(fotoContrapicado) },
      { anio: 2026, lugar: "Actualidad", titulo: "Grupo diversificado", texto: "Telecomunicaciones, energía solar y software en toda la región.", imagen: sinAlt(fotoEquipo) },
    ] as Hito[],
  },
  presencia: {
    encabezado: {
      etiqueta: "Presencia regional",
      titulo: "Conectando Centroamérica.",
      descripcion:
        "Operamos en seis países, con equipos locales y un profundo conocimiento de cada mercado, para ofrecer soluciones integrales y un acompañamiento cercano.",
    },
    imagen: { src: fotoEstadio, alt: "Vista de Tegucigalpa entre montañas" },
    mapa: { src: mapaCentroamerica, alt: "Mapa de Centroamérica con los países donde opera Reddcom" },
    paises: ["El Salvador", "Guatemala", "Honduras", "Nicaragua", "Costa Rica", "Panamá"],
  },
  pilares: {
    encabezado: {
      etiqueta: "Nuestro enfoque",
      titulo: "La forma en que hacemos",
      destacado: "nuestro trabajo.",
      descripcion: "Tres principios que sostienen cada proyecto, desde el diseño hasta el mantenimiento.",
    },
    pilares: [
      { titulo: "Calidad", texto: "Altos estándares técnicos y de seguridad para operaciones confiables y de largo plazo.", imagen: sinAlt(fotoIngeniero), url: "/Servicios/redes-fo" },
      { titulo: "Experiencia", texto: "Más de dos décadas de proyectos en condiciones reales en toda la región.", imagen: sinAlt(fotoAzotea), url: "/proyectos/Reddcom-Honduras" },
      { titulo: "Cumplimiento", texto: "Integridad, compromisos cumplidos y las mejores prácticas de la industria.", imagen: sinAlt(fotoReunion), url: "/nosotros/mision-vision" },
    ] as Tarjeta[],
    lema: { titulo: "Calidad que conecta", destacado: "a toda la región" },
  },
};

/* Contenido del CMS con respaldo campo por campo. */
const cms = await obtenerPagina("nuestraEmpresa");
const hero = heroDe(cms, heroPrueba);

const intro = seccion(cms, "introduccion");
const introduccion = {
  encabezado: intro.uno("encabezado", "encabezado") ?? prueba.introduccion.encabezado,
  parrafos: intro.lista("parrafos", "texto") ?? prueba.introduccion.parrafos,
  imagen: intro.uno("imagen", "imagen") ?? prueba.introduccion.imagen,
  datoDestacado: intro.uno("datoDestacado", "dato") ?? prueba.introduccion.datoDestacado,
  lineas: intro.lista("lineas", "texto") ?? prueba.introduccion.lineas,
  datos: intro.lista("datos", "dato") ?? prueba.introduccion.datos,
};

const tiempo = seccion(cms, "lineaTiempo");
const lineaTiempo = {
  encabezado: tiempo.uno("encabezado", "encabezado") ?? prueba.lineaTiempo.encabezado,
  hitos: tiempo.lista("hitos", "hito") ?? prueba.lineaTiempo.hitos,
};

const region = seccion(cms, "presencia");
const presencia = {
  encabezado: region.uno("encabezado", "encabezado") ?? prueba.presencia.encabezado,
  imagen: region.uno("imagen", "imagen") ?? prueba.presencia.imagen,
  mapa: region.uno("mapa", "imagen") ?? prueba.presencia.mapa,
  paises: region.lista("paises", "texto") ?? prueba.presencia.paises,
};

const enfoque = seccion(cms, "pilares");
const pilares = {
  encabezado: enfoque.uno("encabezado", "encabezado") ?? prueba.pilares.encabezado,
  pilares: enfoque.lista("pilares", "tarjeta") ?? prueba.pilares.pilares,
  lema: enfoque.uno("lema", "encabezado") ?? prueba.pilares.lema,
};

const cierre = cierreDe(cms);

const tonosPilar = ["gris", "primario", "gris"] as const;
const hitoActual = lineaTiempo.hitos.length - 1;
---

<MainLayout
  title="Nuestra Empresa | Reddcom"
  description="Conoce la historia, experiencia y presencia regional de Reddcom."
>
  <HeroPagina {...hero} />

  <!-- =====================================================
       INTRODUCCIÓN  (ref. Aeline: título centrado con fotos en línea + bento de datos)
  ====================================================== -->
  <section id="introduccion" class="bg-surface py-20 font-['Montserrat'] lg:py-28">
    <div class="mx-auto max-w-[1320px] px-6 md:px-8 lg:px-12">
      <div class="mx-auto max-w-[960px] text-center" data-cms="introduccion.encabezado">
        <Etiqueta texto={introduccion.encabezado.etiqueta} />
        <h2
          data-anim="titulo"
          class="mt-5 text-[34px] font-semibold leading-[1.12] tracking-[-0.045em] text-navy-900 md:text-[54px]"
        >
          {introduccion.encabezado.titulo}
          <Foto
            src={fotoCables}
            alt=""
            widths={[120]}
            sizes="60px"
            class="mx-1 inline-block size-[0.85em] rounded-full object-cover align-[-0.08em]"
          />
          <span class="text-navy-900/35">{introduccion.encabezado.destacado}</span>
          <Foto
            src={fotoFibra}
            alt=""
            widths={[120]}
            sizes="60px"
            class="ml-1 inline-block size-[0.85em] rounded-full object-cover align-[-0.08em]"
          />
        </h2>
      </div>

      <div class="mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-12">
        <!-- Foto con dato en placa blanca -->
        <article
          data-anim="revelar"
          data-cms="introduccion.imagen"
          class="relative isolate flex min-h-[380px] items-end overflow-hidden rounded-[24px] p-3 lg:col-span-5"
        >
          <Foto
            src={introduccion.imagen.src}
            alt={introduccion.imagen.alt}
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 520px, 100vw"
            class="absolute inset-0 -z-10 h-full w-full object-cover object-[64%_center]"
          />
          <div class="w-full rounded-[18px] bg-white p-6" data-cms="introduccion.datoDestacado">
            <p data-contar class="text-[56px] font-semibold leading-none tracking-[-0.05em] text-navy-950">
              {introduccion.datoDestacado.valor}
            </p>
            <p class="mt-2 text-[13px] text-body">{introduccion.datoDestacado.etiqueta}</p>
          </div>
        </article>

        <!-- Párrafos con miniaturas -->
        <article data-anim="revelar" data-cms="introduccion.parrafos" class="flex flex-col rounded-[24px] bg-white p-7 lg:col-span-4">
          <p class="text-[13px] text-body">Nuestra trayectoria</p>
          <div class="mt-auto pt-10">
            <div class="flex -space-x-3">
              {
                [fotoAzotea, fotoIngeniero, fotoReunion, fotoEquipo].map((foto) => (
                  <Foto src={foto} alt="" widths={[96]} sizes="44px" class="size-11 rounded-full border-2 border-white object-cover" />
                ))
              }
            </div>
            {introduccion.parrafos.map((parrafo) => <p class="mt-5 text-[15px] leading-7 text-navy-900">{parrafo}</p>)}
          </div>
        </article>

        <!-- Líneas de negocio + dato oscuro -->
        <div class="grid gap-4 md:col-span-2 md:grid-cols-2 lg:col-span-3 lg:grid-cols-1">
          <article data-anim="revelar" data-cms="introduccion.lineas" class="flex flex-col rounded-[24px] bg-primary-300 p-7 text-navy-950">
            <p class="text-[13px] font-medium">Líneas de negocio</p>
            <ul class="mt-auto flex flex-wrap gap-2 pt-8">
              {introduccion.lineas.map((linea) => <li class="rounded-full bg-white/60 px-4 py-2 text-[13px] font-semibold">{linea}</li>)}
            </ul>
          </article>
          {
            introduccion.datos.map((dato) => (
              <article data-anim="revelar" data-cms="introduccion.datos" class="flex items-center justify-between rounded-[24px] bg-navy-950 p-7 text-white">
                <p class="text-[13px] text-white/75">{dato.etiqueta}</p>
                <p data-contar class="text-[44px] font-semibold leading-none tracking-[-0.04em]">{dato.valor}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================
       LÍNEA DE TIEMPO  (ref. "Popular Destination": tarjetas con foto y flechas)
  ====================================================== -->
  <section id="linea-tiempo" data-pista-grupo class="bg-white py-20 font-['Montserrat'] lg:py-28">
    <div class="mx-auto max-w-[1320px] px-6 md:px-8 lg:px-12">
      <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
        <EncabezadoSeccion {...lineaTiempo.encabezado} cms="lineaTiempo.encabezado" class="max-w-[720px]" />
        <div class="flex gap-3">
          <button
            type="button"
            data-pista-anterior
            aria-label="Hitos anteriores"
            class="flex size-12 items-center justify-center rounded-full bg-surface text-navy-900 transition-colors hover:bg-surface-tint"
          >
            <ArrowLeft size={18} aria-hidden="true" />
          </button>
          <button
            type="button"
            data-pista-siguiente
            aria-label="Hitos siguientes"
            class="flex size-12 items-center justify-center rounded-full bg-navy-950 text-white transition-colors hover:bg-primary-700"
          >
            <ArrowRight size={18} aria-hidden="true" />
          </button>
        </div>
      </div>

      <ol
        data-pista
        data-cms="lineaTiempo.hitos"
        class="mt-12 flex snap-x snap-mandatory gap-5 overflow-x-auto pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        {
          lineaTiempo.hitos.map((hito, indice) => (
            <li data-anim="revelar" class="w-[290px] shrink-0 snap-start md:w-[340px]">
              {hito.imagen && (
              <Foto
                src={hito.imagen.src}
                alt={hito.imagen.alt}
                widths={[360, 720]}
                sizes="340px"
                class="aspect-[16/11] w-full rounded-[22px] object-cover"
              />
              )}
              <div class="mt-4 flex items-start justify-between gap-4 px-1">
                <div>
                  <h3 class="text-[19px] font-semibold text-navy-900">{hito.titulo}</h3>
                  <p class="mt-1 flex items-center gap-1.5 text-[12px] text-body">
                    <MapPin size={13} aria-hidden="true" />
                    {hito.lugar}
                  </p>
                </div>
                <span
                  class:list={[
                    "rounded-full px-3 py-1 text-[13px] font-semibold",
                    indice === hitoActual ? "bg-accent text-white" : "bg-primary-600 text-white",
                  ]}
                >
                  {hito.anio}
                </span>
              </div>
              <p class="mt-3 px-1 text-[13px] leading-6 text-body">{hito.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- =====================================================
       PRESENCIA REGIONAL  (ref. Axios: título con línea, foto en B/N, insignia giratoria)
  ====================================================== -->
  <section id="presencia" class="bg-surface py-20 font-['Montserrat'] lg:py-28">
    <div class="mx-auto max-w-[1320px] px-6 md:px-8 lg:px-12">
      <div class="flex items-center gap-6">
        <span class="hidden h-px w-32 bg-navy-900/30 md:block" aria-hidden="true"></span>
        <EncabezadoSeccion etiqueta={presencia.encabezado.etiqueta} titulo={presencia.encabezado.titulo} cms="presencia.encabezado" />
      </div>

      <div class="mt-12 grid gap-6 lg:grid-cols-12">
        <div data-anim="foto" data-cms="presencia.imagen" class="overflow-hidden rounded-[24px] lg:col-span-4">
          <Foto
            src={presencia.imagen.src}
            alt={presencia.imagen.alt}
            widths={[480, 720]}
            sizes="(min-width: 1024px) 400px, 100vw"
            class="h-full min-h-[320px] w-full object-cover grayscale"
          />
        </div>

        <div class="flex flex-col gap-6 lg:col-span-8">
          <div class="flex flex-col gap-8 md:flex-row md:items-center">
            <p data-anim="revelar" class="max-w-[460px] text-[15px] leading-7 text-body">
              {presencia.encabezado.descripcion}
            </p>
            <InsigniaGiratoria texto="6 países · Centroamérica · Reddcom ·" class="md:ml-auto" />
          </div>

          <div data-anim="revelar" class="relative rounded-[24px] bg-navy-900 p-6 md:p-10">
            <Foto
              data-cms="presencia.mapa"
              src={presencia.mapa.src}
              alt={presencia.mapa.alt}
              widths={[640, 960, 1280]}
              sizes="(min-width: 1024px) 760px, 100vw"
              class="h-auto w-full"
            />
            <ul class="mt-6 flex flex-wrap gap-2" aria-label="Países donde operamos" data-cms="presencia.paises">
              {
                presencia.paises.map((pais) => (
                  <li class="rounded-full border border-white/20 px-4 py-2 text-[13px] font-medium text-white">{pais}</li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================
       PILARES  (ref. "Our Classes": contenedor con borde, tarjetas con muesca y lema gigante)
  ====================================================== -->
  <section id="pilares" class="bg-white py-20 font-['Montserrat'] lg:py-28">
    <div class="mx-auto max-w-[1320px] px-6 md:px-8 lg:px-12">
      <div class="rounded-[36px] border border-navy-900/15 p-6 md:p-10 lg:p-14">
        <EncabezadoSeccion {...pilares.encabezado} alineacion="dividido" cms="pilares.encabezado" />

        <div class="mt-12 grid gap-5 md:grid-cols-3" data-cms="pilares.pilares">
          {
            pilares.pilares.map((pilar, indice) => (
              <TarjetaMuesca href={pilar.url} etiqueta={`Más sobre ${pilar.titulo}`} tono={tonosPilar[indice]}>
                <h3 class="pr-12 text-[30px] font-semibold leading-none tracking-[-0.04em]">{pilar.titulo}</h3>
                <p class:list={["mt-3 text-[14px] leading-6", indice === 1 ? "text-white/85" : "text-body"]}>
                  {pilar.texto}
                </p>
                {pilar.imagen && (
                <Foto
                  src={pilar.imagen.src}
                  alt=""
                  widths={[400, 640]}
                  sizes="(min-width: 768px) 360px, 100vw"
                  class="mt-8 aspect-[4/3] w-full rounded-[18px] object-cover"
                />
                )}
              </TarjetaMuesca>
            ))
          }
        </div>

        <p
          data-anim="titulo"
          data-cms="pilares.lema"
          class="mt-14 text-center text-[34px] font-bold uppercase leading-[1] tracking-[-0.03em] text-navy-900 md:text-[56px]"
        >
          {pilares.lema.titulo} <span class="text-primary-600">{pilares.lema.destacado}</span>
        </p>
      </div>
    </div>
  </section>

  <BannerCta {...cierre} />
</MainLayout>

