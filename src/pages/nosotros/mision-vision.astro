---
import Foto from "../../components/ui/Foto.astro";
import MainLayout from "../../layout/MainLayout.astro";
import { obtenerPagina, seccion, type Tarjeta } from "../../lib/cms";
import tecnicoReddcom from "../../assets/Servicios/01-construccion.png";
// Fotos temporales de Unsplash y Pexels (licencia libre): se reemplazarán por fotos del equipo desde el CMS
import fotoMision from "../../assets/mision-vision/temporal-fibra-switch.jpg";
import fotoVision from "../../assets/mision-vision/temporal-ciudad-noche.jpg";
import texturaValores from "../../assets/mision-vision/temporal-torre-nubes.jpg";
import fotoResponsabilidad from "../../assets/mision-vision/temporal-valor-responsabilidad.jpg";
import fotoEtica from "../../assets/mision-vision/temporal-valor-etica.jpg";
import fotoDisciplina from "../../assets/mision-vision/temporal-valor-disciplina.jpg";
import fotoDedicacion from "../../assets/mision-vision/temporal-valor-dedicacion.jpg";
import fotoCompromiso from "../../assets/mision-vision/temporal-valor-compromiso.jpg";
import fotoObjetividad from "../../assets/mision-vision/temporal-valor-objetividad.jpg";
import fotoMotivacion from "../../assets/mision-vision/temporal-valor-motivacion.jpg";
import {
  ArrowRight,
  ChartNoAxesColumn,
  ClipboardList,
  Handshake,
  Lightbulb,
  RadioTower,
  Scale,
  ShieldCheck,
  Telescope,
  Wrench,
} from "@lucide/astro";

/* Datos de prueba: se muestran mientras el campo del CMS (registro `misionVision`)
   esté vacío. Íconos y forma de las tarjetas los decide el diseño, por posición. */
const prueba = {
  hero: {
    encabezado: {
      etiqueta: "Nuestro propósito",
      titulo: "Misión y",
      destacado: "Visión",
      descripcion: "Nuestros principios nos guían y nos impulsan a seguir construyendo conexiones que generan un mejor futuro.",
    },
    imagen: { src: "/images/mision-vision/reddcom-honduras.webp", alt: "Visión y desarrollo de Reddcom" },
  },
  mision: {
    titulo: "Construimos conexiones para el desarrollo regional",
    texto:
      "Ser una empresa multidisciplinaria dispuesta a brindar Servicios de Construcción, Adecuación, expansión, enlaces y Mantenimiento de sitios en el Área de telefonía móvil remota a nivel regional centroamericano.",
    imagen: { src: fotoMision, alt: "Cables de fibra óptica conectados a un equipo de red" },
  },
  vision: {
    titulo: "Ser líderes a nivel regional",
    texto:
      "Ser una empresa líder a nivel regional manteniendo la excelencia, y establecernos como la principal opción de nuestros clientes.",
    imagen: { src: fotoVision, alt: "" },
  },
  imagenCentral: { src: tecnicoReddcom, alt: "Técnico de Reddcom trabajando en una torre de telecomunicaciones" },
  lema: "Construimos conexiones",
  datos: [
    { valor: "+20", etiqueta: "años de experiencia en la región" },
    { valor: "6", etiqueta: "países con presencia regional" },
  ],
  valores: {
    encabezado: {
      etiqueta: "Nuestros valores",
      titulo: "Lo que nos define",
      descripcion: "Valores que guían nuestro trabajo y reflejan el compromiso de nuestro equipo.",
    },
    tarjetas: [
      { titulo: "Responsabilidad", imagen: { src: fotoResponsabilidad, alt: "" } },
      { titulo: "Ética", imagen: { src: fotoEtica, alt: "" } },
      { titulo: "Disciplina", imagen: { src: fotoDisciplina, alt: "" } },
      { titulo: "Dedicación", imagen: { src: fotoDedicacion, alt: "" } },
      { titulo: "Compromiso", imagen: { src: fotoCompromiso, alt: "" } },
      { titulo: "Objetividad", imagen: { src: fotoObjetividad, alt: "" } },
      { titulo: "Motivación", imagen: { src: fotoMotivacion, alt: "" } },
    ] as Tarjeta[],
    boton: { texto: "Únete al equipo", url: "/Oportunidades-Laborales" },
    datos: [
      { valor: "2005", etiqueta: "Fundación" },
      { valor: "ISO 9001:2015", etiqueta: "Gestión de calidad" },
    ],
    textura: { src: texturaValores, alt: "" },
  },
};

/* Contenido del CMS con respaldo campo por campo. */
const cms = await obtenerPagina("misionVision");

const lecturaHero = seccion(cms, "hero");
const hero = {
  encabezado: lecturaHero.uno("encabezado", "encabezado") ?? prueba.hero.encabezado,
  imagen: lecturaHero.uno("imagen", "imagen") ?? prueba.hero.imagen,
};

const lecturaMv = seccion(cms, "misionVision");
const misionCms = lecturaMv.uno("mision", "tarjeta");
const visionCms = lecturaMv.uno("vision", "tarjeta");
const mision = {
  icono: RadioTower,
  titulo: misionCms?.titulo ?? prueba.mision.titulo,
  texto: misionCms?.texto ?? prueba.mision.texto,
  imagen: misionCms?.imagen ?? prueba.mision.imagen,
};
const vision = {
  icono: Telescope,
  titulo: visionCms?.titulo ?? prueba.vision.titulo,
  texto: visionCms?.texto ?? prueba.vision.texto,
  imagen: visionCms?.imagen ?? prueba.vision.imagen,
};
const imagenCentral = lecturaMv.uno("imagen", "imagen") ?? prueba.imagenCentral;
// La tipografía gigante va en dos líneas: la primera palabra y el resto.
const [lemaInicio, ...lemaResto] = (lecturaMv.uno("lema", "texto") ?? prueba.lema).split(" ");
const [datoSuperior, datoInferior] = lecturaMv.lista("datos", "dato") ?? prueba.datos;

const lecturaValores = seccion(cms, "valores");
const encabezadoValores = lecturaValores.uno("encabezado", "encabezado") ?? prueba.valores.encabezado;
const botonValores = lecturaValores.uno("boton", "enlace") ?? prueba.valores.boton;
const datosValores = lecturaValores.lista("datos", "dato") ?? prueba.valores.datos;
const texturaFondo = lecturaValores.uno("textura", "imagen") ?? prueba.valores.textura;

const iconosValor = [ShieldCheck, Scale, ClipboardList, Wrench, Handshake, ChartNoAxesColumn, Lightbulb];
const valores = (lecturaValores.lista("valores", "tarjeta") ?? prueba.valores.tarjetas).map((tarjeta, indice) => ({
  nombre: tarjeta.titulo,
  icono: iconosValor[indice % iconosValor.length],
  foto: tarjeta.imagen,
}));

/* Arco de valores (solo desktop): cada tarjeta se ubica sobre un arco
   que va de 195° a -15°. x/y salen de cos/sin del ángulo y el giro
   acompaña la curva, suavizado al 20% para que el texto se lea. */
const ARCO = { radio: 400, centroY: 450, desde: 195, hasta: -15 };

const valoresEnArco = valores.map((valor, index) => {
  const paso = (ARCO.desde - ARCO.hasta) / (valores.length - 1);
  const angulo = ARCO.desde - index * paso;
  const radianes = (angulo * Math.PI) / 180;

  return {
    ...valor,
    x: Math.round(ARCO.radio * Math.cos(radianes)),
    y: Math.round(ARCO.centroY - ARCO.radio * Math.sin(radianes)),
    giro: Math.round((90 - angulo) * 0.2),
  };
});
---

<MainLayout
  title="Misión y Visión | Reddcom"
  description="Conoce la misión, visión y valores que guían el trabajo de Reddcom."
>
  <section
    id="hero"
    data-cms="hero.imagen"
    class="
      overflow-hidden
      bg-surface
      pt-[105px]
      font-['Montserrat']
    "
  >
    <!-- =====================================================
         HERO
    ====================================================== -->
    <div class="relative">

      <!-- IMAGEN DE FONDO -->
      <div
        class="
          absolute
          inset-x-0
          top-0
          h-[520px]
          overflow-hidden
          lg:h-[610px]
        "
      >
        <img
          src={typeof hero.imagen.src === "string" ? hero.imagen.src : hero.imagen.src.src}
          alt={hero.imagen.alt}
          class="
            h-full
            w-full
            object-cover
            object-center
          "
        />

        <!-- DEGRADADO IZQUIERDO -->
        <div
          class="
            absolute
            inset-0
            bg-gradient-to-r
            from-white
            via-white/90
            to-white/0
            lg:via-white/55
          "
        ></div>

        <!-- DEGRADADO INFERIOR -->
        <div
          class="
            absolute
            inset-x-0
            bottom-0
            h-[160px]
            bg-gradient-to-t
            from-surface
            to-transparent
          "
        ></div>
      </div>

      <!-- CONTENIDO HERO -->
      <div
        class="
          relative
          z-10
          mx-auto
          max-w-[1320px]
          px-6
          md:px-8
          lg:px-12
        "
      >
        <div
          class="
            flex
            min-h-[520px]
            items-start
            justify-between
            pt-16
            lg:min-h-[610px]
            lg:pt-20
          "
        >
          <!-- TEXTO IZQUIERDO -->
          <div class="max-w-[570px]">

            <div class="flex items-center gap-5">
              <span
                class="
                  h-[2px]
                  w-[48px]
                  bg-primary-600
                "
              ></span>

              <span
                class="
                  text-[11px]
                  font-semibold
                  uppercase
                  tracking-[0.2em]
                  text-navy-900
                "
              >
                {hero.encabezado.etiqueta}
              </span>
            </div>

            <h1
              data-cms="hero.encabezado"
              class="
                mt-7
                text-[48px]
                font-semibold
                leading-[0.98]
                tracking-[-0.05em]
                text-navy-900
                md:text-[64px]
                lg:text-[72px]
              "
            >
              {hero.encabezado.titulo}

              <span class="block text-primary-600">
                {hero.encabezado.destacado}
              </span>
            </h1>

            <p
              class="
                mt-6
                max-w-[430px]
                text-[14px]
                leading-[1.65]
                text-body
                md:text-[16px]
              "
            >
              {hero.encabezado.descripcion}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================
       MISIÓN Y VISIÓN  (ref. tipografía gigante + imagen inclinada)
  ====================================================== -->
  <section id="mision-vision" class="overflow-hidden bg-surface pb-24 font-['Montserrat'] lg:pb-32">
    <div class="mx-auto max-w-[1320px] px-6 md:px-8 lg:px-12">

      <!-- FILA SUPERIOR: dato + misión -->
      <div class="grid items-start gap-8 lg:grid-cols-12">
        <div
          data-cms="misionVision.datos"
          class="
            flex h-40 w-40 flex-col items-center justify-center rounded-full
            bg-accent text-center
            lg:col-span-3
          "
        >
          <p class="text-[34px] font-semibold tracking-[-0.04em] text-navy-950">{datoSuperior?.valor}</p>
          <p class="mt-1 max-w-[110px] text-[12px] font-medium leading-4 text-navy-950">
            {datoSuperior?.etiqueta}
          </p>
        </div>

        <article data-cms="misionVision.mision" class="group relative overflow-hidden rounded-sm bg-white p-3 lg:col-span-6 lg:col-start-7">
          <Foto
            src={mision.imagen.src}
            alt={mision.imagen.alt}
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 600px, 100vw"
            class="
              aspect-[16/7] w-full rounded-sm object-cover grayscale-[45%]
              transition-[filter] duration-500 group-hover:grayscale-0
            "
          />

          <div class="px-5 pb-5 pt-7 lg:px-7 lg:pb-7">
            <div class="flex items-center gap-3">
              <span
                class="
                  flex h-10 w-10 items-center justify-center rounded-sm bg-navy-900 text-white
                  transition-colors duration-300 group-hover:bg-primary-700
                "
              >
                <mision.icono size={20} stroke-width={1.6} aria-hidden="true" />
              </span>
              <p class="text-[13px] font-semibold uppercase tracking-[0.15em] text-primary-700">
                Misión
              </p>
            </div>

            <h2 class="mt-6 text-[26px] font-semibold leading-[1.15] tracking-[-0.03em] text-navy-900 md:text-[30px]">
              {mision.titulo}
            </h2>
            <p class="mt-4 text-[15px] leading-7 text-body">
              {mision.texto}
            </p>
          </div>

          <span
            aria-hidden="true"
            class="
              absolute inset-x-0 bottom-0 h-[3px] origin-left scale-x-0 bg-accent
              transition-transform duration-500 group-hover:scale-x-100
            "
          ></span>
        </article>
      </div>

      <!-- TIPOGRAFÍA GIGANTE + IMAGEN -->
      <div class="relative my-16 lg:my-28">
        <p
          aria-hidden="true"
          data-cms="misionVision.lema"
          class="
            select-none font-semibold leading-[0.95] tracking-[-0.06em]
            text-[52px]
            sm:text-[72px]
            xl:text-[96px]
          "
        >
          <span class="block text-navy-900/20">{lemaInicio}</span>
          <span class="block text-right text-navy-900">{lemaResto.join(" ")}</span>
        </p>

        <Foto
          data-cms="misionVision.imagen"
          src={imagenCentral.src}
          alt={imagenCentral.alt}
          widths={[320, 480, 640]}
          sizes="(min-width: 1024px) 300px, 80vw"
          class="
            mx-auto mt-10 aspect-[4/5] w-[70%] max-w-[230px] -rotate-6
            rounded-sm object-cover object-[62%_center]
            transition-[rotate] duration-500 ease-out hover:-rotate-2
            lg:absolute lg:left-[53%] lg:top-1/2 lg:mt-0 lg:w-[220px]
            lg:-translate-x-1/2 lg:-translate-y-1/2
            xl:left-[54%] xl:w-[260px]
          "
        />
      </div>

      <!-- FILA INFERIOR: visión + dato -->
      <div class="grid items-end gap-8 lg:grid-cols-12">
        <article data-cms="misionVision.vision" class="group relative isolate overflow-hidden rounded-sm bg-navy-900 p-8 text-white lg:col-span-6 lg:p-10">
          <Foto
            src={vision.imagen.src}
            alt={vision.imagen.alt}
            widths={[640, 960, 1280]}
            sizes="(min-width: 1024px) 600px, 100vw"
            class="
              absolute inset-0 -z-10 h-full w-full object-cover object-[center_70%] opacity-60
              transition-opacity duration-500 group-hover:opacity-90
            "
          />
          <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-900 via-navy-900/85 to-navy-900/30"></div>

          <div class="flex items-center gap-3">
            <span
              class="
                flex h-10 w-10 items-center justify-center rounded-sm bg-primary-600 text-white
                transition-colors duration-300 group-hover:bg-accent group-hover:text-navy-950
              "
            >
              <vision.icono size={20} stroke-width={1.6} aria-hidden="true" />
            </span>
            <p class="text-[13px] font-semibold uppercase tracking-[0.15em] text-primary-300">
              Visión
            </p>
          </div>

          <h2 class="mt-24 text-[26px] font-semibold leading-[1.15] tracking-[-0.03em] md:text-[30px]">
            {vision.titulo}
          </h2>
          <p class="mt-4 max-w-[440px] text-[15px] leading-7 text-white/85">
            {vision.texto}
          </p>

          <span
            aria-hidden="true"
            class="
              absolute inset-x-0 bottom-0 h-[3px] origin-left scale-x-0 bg-accent
              transition-transform duration-500 group-hover:scale-x-100
            "
          ></span>
        </article>

        <div
          data-cms="misionVision.datos"
          class="
            flex h-40 w-40 flex-col items-center justify-center rounded-full
            bg-accent text-center
            lg:col-span-3 lg:col-start-10 lg:justify-self-end
          "
        >
          <p class="text-[34px] font-semibold tracking-[-0.04em] text-navy-950">{datoInferior?.valor}</p>
          <p class="mt-1 max-w-[110px] text-[12px] font-medium leading-4 text-navy-950">
            {datoInferior?.etiqueta}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================
       VALORES  (ref. arco de imágenes)
  ====================================================== -->
  <section id="valores" data-cms="valores.textura" class="relative isolate overflow-hidden bg-surface py-24 font-['Montserrat'] lg:py-28">
    <!-- FOTO DE FONDO: velo claro para que el texto navy se lea sobre las nubes -->
    <Foto
      src={texturaFondo.src}
      alt={texturaFondo.alt}
      widths={[960, 1600, 2400]}
      sizes="100vw"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-surface/85 via-surface/55 to-surface/90"></div>

    <div class="relative mx-auto max-w-[1100px] px-6 md:px-8 lg:h-[700px] lg:px-0">

      <!-- CENTRO -->
      <div class="mx-auto max-w-[460px] text-center lg:absolute lg:inset-x-0 lg:top-[215px]">
        <p class="text-[13px] font-semibold uppercase tracking-[0.15em] text-primary-700">
          {encabezadoValores.etiqueta}
        </p>

        <h2 data-cms="valores.encabezado" class="mt-4 text-[40px] font-semibold leading-[1] tracking-[-0.045em] text-navy-900 md:text-[52px]">
          {encabezadoValores.titulo}
        </h2>

        <p class="mx-auto mt-5 max-w-[360px] text-[15px] leading-7 text-navy-900/80">
          {encabezadoValores.descripcion}
        </p>

        <a
          href={botonValores.url}
          data-cms="valores.boton"
          class="
            group mt-7 inline-flex h-11 items-center gap-2 rounded-full bg-navy-900 px-6
            text-sm font-semibold text-white no-underline
            transition-colors duration-200 hover:bg-primary-700
          "
        >
          {botonValores.texto}
          <ArrowRight
            size={16}
            aria-hidden="true"
            class="transition-transform duration-200 group-hover:translate-x-0.5"
          />
        </a>

        <dl data-cms="valores.datos" class="mt-9 grid grid-cols-2 divide-x divide-navy-900/20">
          {
            datosValores.map((dato) => (
              <div class="px-4">
                <dt class="text-[12px] text-body">{dato.etiqueta}</dt>
                <dd class="mt-1 text-[18px] font-semibold text-navy-900">{dato.valor}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <!-- TARJETAS (ref. tarjeta con foto y esquinas asimétricas, utilidad `silueta`
           de global.css): retícula en móvil, arco en desktop -->
      <ul
        data-valores
        data-cms="valores.valores"
        data-centro-y={ARCO.centroY}
        class="mt-14 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:mt-0"
      >
        {
          valoresEnArco.map((valor) => (
            <li
              data-valor
              data-x={valor.x}
              data-y={valor.y}
              data-giro={valor.giro}
              style={`--x: ${valor.x}px; --y: ${valor.y}px; --giro: ${valor.giro}deg;`}
              class="
                silueta group relative isolate aspect-[4/5] overflow-hidden
                lg:absolute lg:left-[calc(50%+var(--x))] lg:top-[calc(var(--y)+var(--flotar,0px))]
                lg:aspect-auto lg:h-[200px] lg:w-[160px] lg:-translate-x-1/2 lg:-translate-y-1/2
                lg:rotate-(--giro)
              "
            >
              {valor.foto && (
              <Foto
                src={valor.foto.src}
                alt={valor.foto.alt}
                widths={[300, 450]}
                sizes="(min-width: 1024px) 160px, 45vw"
                class="
                  absolute inset-0 -z-10 h-full w-full object-cover grayscale-[40%]
                  transition-[filter] duration-500 group-hover:grayscale-0
                "
              />
              )}

              <!-- Tinte azul de marca: desaparece en hover para mostrar la foto real -->
              <div
                class="
                  absolute inset-0 -z-10 bg-navy-900/50 mix-blend-multiply
                  transition-opacity duration-500 group-hover:opacity-0
                "
              ></div>

              <div
                class="
                  absolute bottom-[19%] left-[calc(50%+4px)] flex -translate-x-1/2 items-center gap-1.5 whitespace-nowrap
                  rounded-[10px] border border-white/30 bg-white/20 px-2.5 py-1.5 text-white backdrop-blur-md
                  transition-colors duration-300 group-hover:border-primary-600 group-hover:bg-primary-600
                "
              >
                <valor.icono size={14} stroke-width={2} aria-hidden="true" class="shrink-0" />
                <h3 class="text-[11.5px] font-semibold">{valor.nombre}</h3>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</MainLayout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  let contexto: gsap.MatchMedia | undefined;

  function animarValores() {
    const lista = document.querySelector<HTMLElement>("[data-valores]");
    if (!lista) return;

    const placas = lista.querySelectorAll<HTMLElement>("[data-valor]");
    const centroY = `${lista.dataset.centroY}px`;

    contexto = gsap.matchMedia();

    // Desktop: las placas nacen apiladas en el centro del arco y se abren en abanico.
    // Solo se animan variables CSS (--x, --y, --giro, --flotar): el centrado y el giro
    // los pone Tailwind, y tocar `transform` desde GSAP los anularía.
    contexto.add("(min-width: 1024px) and (prefers-reduced-motion: no-preference)", () => {
      gsap.fromTo(
        placas,
        { "--x": "0px", "--y": centroY, "--giro": "0deg", opacity: 0 },
        {
          "--x": (_: number, placa: HTMLElement) => `${placa.dataset.x}px`,
          "--y": (_: number, placa: HTMLElement) => `${placa.dataset.y}px`,
          "--giro": (_: number, placa: HTMLElement) => `${placa.dataset.giro}deg`,
          opacity: 1,
          duration: 1.1,
          ease: "power3.out",
          stagger: { each: 0.06, from: "center" },
          scrollTrigger: { trigger: lista, start: "top 75%", once: true },
        },
      );

      // Hover: la placa se endereza y sube; al salir vuelve a su ángulo en el arco
      const limpiezas = [...placas].map((placa) => {
        const entrar = () =>
          gsap.to(placa, { "--giro": "0deg", "--flotar": "-8px", duration: 0.3, ease: "power2.out", overwrite: "auto" });
        const salir = () =>
          gsap.to(placa, {
            "--giro": `${placa.dataset.giro}deg`,
            "--flotar": "0px",
            duration: 0.3,
            ease: "power2.out",
            overwrite: "auto",
          });

        placa.addEventListener("mouseenter", entrar);
        placa.addEventListener("mouseleave", salir);

        return () => {
          placa.removeEventListener("mouseenter", entrar);
          placa.removeEventListener("mouseleave", salir);
        };
      });

      return () => limpiezas.forEach((limpiar) => limpiar());
    });

    // Móvil/tablet: entrada simple en cascada
    contexto.add("(max-width: 1023px) and (prefers-reduced-motion: no-preference)", () => {
      gsap.from(placas, {
        y: 24, // aquí no hay giro ni centrado de Tailwind, así que `y` es seguro
        opacity: 0,
        duration: 0.6,
        ease: "power2.out",
        stagger: 0.06,
        scrollTrigger: { trigger: lista, start: "top 85%", once: true },
      });
    });
  }

  // Con ClientRouter las páginas se cambian sin recargar: se inicia en cada
  // carga y se limpia antes de salir para no dejar animaciones huérfanas.
  document.addEventListener("astro:page-load", animarValores);
  document.addEventListener("astro:before-swap", () => contexto?.revert());
</script>
