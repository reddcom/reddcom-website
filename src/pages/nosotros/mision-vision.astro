---
import MainLayout from "../../layout/MainLayout.astro";
---

<MainLayout
	title="Misión y Visión | Reddcom"
	description="Conoce la misión y visión de Reddcom."
>

	<section
		class="
			min-h-screen
			bg-[#f7f9fb]
			px-6
			pb-24
			pt-36
			font-['Montserrat']
			md:px-8
			lg:px-12
		"
	>
		<div class="mx-auto max-w-[1320px]">

			<span
				class="
					text-[10px]
					font-semibold
					tracking-[0.32em]
					text-[#1595d3]
				"
			>
				NUESTRO PROPÓSITO
			</span>

			<h1
				class="
					mt-5
					max-w-[750px]
					text-[44px]
					font-semibold
					leading-[1.05]
					tracking-[-0.04em]
					text-[#102f4d]
					md:text-[60px]
				"
			>
				Misión y
				<span class="text-[#1595d3]">
					Visión.
				</span>
			</h1>

			<!-- Aquí pondremos el diseño de
			     Misión + Visión + Valores -->

		</div>
	</section>

</MainLayout>