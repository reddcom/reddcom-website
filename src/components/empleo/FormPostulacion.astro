---
import { CircleCheck, FileText, Mail, Upload } from "@lucide/astro";
import Etiqueta from "../ui/Etiqueta.astro";
import type { Encabezado } from "../hero/tipos";

/* Formulario de postulación, siempre visible en el detalle de la vacante.
   La validación en tiempo real y el envío viven en src/scripts/postulacion.ts;
   cada campo tiene su contenedor [data-campo] con su mensaje de error. */
interface Props {
  vacanteId: string;
  vacanteTitulo: string;
  encabezado: Encabezado;
  correoRrhh: string;
}

const { vacanteId, vacanteTitulo, encabezado, correoRrhh } = Astro.props;

const claseCampo =
  "mt-2 w-full rounded-[14px] border border-navy-900/15 bg-surface px-4 py-3 text-[15px] text-navy-900 outline-none transition-colors placeholder:text-body-soft focus:border-primary-600 focus:bg-white aria-[invalid=true]:border-red-500 aria-[invalid=true]:bg-red-50/50";
const claseEtiqueta = "text-[13px] font-semibold text-navy-900";
const claseError = "mt-1.5 text-[13px] text-red-700 empty:hidden";
---

<section id="postular" aria-labelledby="postular-titulo" class="scroll-mt-28">
  <div data-cms="postulacion.encabezado">
    {encabezado.etiqueta && <Etiqueta texto={encabezado.etiqueta} />}
    <h2 id="postular-titulo" class="mt-4 text-[30px] font-semibold leading-tight tracking-[-0.03em] text-navy-900">
      {encabezado.titulo}
    </h2>
    <p class="mt-3 text-[15px] leading-7 text-body">
      {encabezado.descripcion ?? `Envíanos tus datos y tu CV para la vacante de ${vacanteTitulo}. Te contactaremos si tu perfil avanza.`}
    </p>
  </div>

  <form data-postulacion data-vacante={vacanteId} novalidate class="mt-8 grid gap-5">
    <div data-campo="nombre">
      <label for="p-nombre" class={claseEtiqueta}>Nombre completo *</label>
      <input id="p-nombre" name="nombre" autocomplete="name" required aria-describedby="p-nombre-error" class={claseCampo} />
      <p id="p-nombre-error" data-error class={claseError} aria-live="polite"></p>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div data-campo="correo">
        <label for="p-correo" class={claseEtiqueta}>Correo *</label>
        <input
          id="p-correo"
          name="correo"
          type="email"
          inputmode="email"
          autocomplete="email"
          required
          placeholder="nombre@dominio.com"
          aria-describedby="p-correo-error"
          class={claseCampo}
        />
        <p id="p-correo-error" data-error class={claseError} aria-live="polite"></p>
      </div>
      <div data-campo="telefono">
        <label for="p-telefono" class={claseEtiqueta}>Teléfono *</label>
        <input
          id="p-telefono"
          name="telefono"
          type="tel"
          inputmode="tel"
          autocomplete="tel"
          required
          placeholder="+504 9999-9999"
          aria-describedby="p-telefono-error"
          class={claseCampo}
        />
        <p id="p-telefono-error" data-error class={claseError} aria-live="polite"></p>
      </div>
    </div>

    <div data-campo="enlace">
      <label for="p-enlace" class={claseEtiqueta}>LinkedIn o portafolio <span class="font-normal text-body">(opcional)</span></label>
      <input
        id="p-enlace"
        name="enlace"
        type="url"
        inputmode="url"
        placeholder="https://linkedin.com/in/tu-perfil"
        aria-describedby="p-enlace-error"
        class={claseCampo}
      />
      <p id="p-enlace-error" data-error class={claseError} aria-live="polite"></p>
    </div>

    <!-- CV: el input real queda oculto; la zona entera es su etiqueta y acepta arrastrar -->
    <div data-campo="cv">
      <span id="p-cv-etiqueta" class={claseEtiqueta}>CV en PDF *</span>
      <label
        data-zona-cv
        for="p-cv"
        class="mt-2 flex cursor-pointer items-center gap-4 rounded-[14px] border border-dashed border-navy-900/25 bg-surface px-4 py-4 transition-colors hover:border-primary-600 has-[:focus-visible]:border-primary-600 data-[arrastrando]:border-primary-600 data-[arrastrando]:bg-surface-tint data-[invalido]:border-red-500 data-[invalido]:bg-red-50/50"
      >
        <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-white text-primary-700">
          <Upload size={18} aria-hidden="true" data-icono-vacio />
          <FileText size={18} aria-hidden="true" data-icono-listo class="hidden" />
        </span>
        <span class="min-w-0 flex-1">
          <span data-nombre-cv class="block truncate text-[14px] font-semibold text-navy-900">Adjunta tu CV o arrástralo aquí</span>
          <span data-detalle-cv class="block text-[12px] text-body">Solo PDF · máximo 5 MB</span>
        </span>
        <input
          id="p-cv"
          name="cv"
          type="file"
          accept="application/pdf,.pdf"
          required
          aria-labelledby="p-cv-etiqueta"
          aria-describedby="p-cv-error"
          class="sr-only"
        />
      </label>
      <p id="p-cv-error" data-error class={claseError} aria-live="polite"></p>
    </div>

    <div data-campo="mensaje">
      <div class="flex items-baseline justify-between gap-3">
        <label for="p-mensaje" class={claseEtiqueta}>Mensaje <span class="font-normal text-body">(opcional)</span></label>
        <span data-contador class="text-[12px] tabular-nums text-body">0 / 1000</span>
      </div>
      <textarea
        id="p-mensaje"
        name="mensaje"
        rows="4"
        maxlength="1000"
        placeholder="Cuéntanos por qué te interesa esta vacante."
        aria-describedby="p-mensaje-error"
        class={claseCampo}></textarea>
      <p id="p-mensaje-error" data-error class={claseError} aria-live="polite"></p>
    </div>

    <div data-campo="consentimiento">
      <label class="flex items-start gap-3 text-[13px] leading-6 text-body">
        <input
          id="p-consentimiento"
          name="consentimiento"
          type="checkbox"
          required
          aria-describedby="p-consentimiento-error"
          class="mt-1 size-4 shrink-0 accent-navy-900"
        />
        Autorizo a Reddcom a usar mis datos y mi CV solo para este proceso de selección.
      </label>
      <p id="p-consentimiento-error" data-error class={claseError} aria-live="polite"></p>
    </div>

    <!-- Trampa para bots: oculto para las personas -->
    <div class="hidden" aria-hidden="true">
      <label>Sitio web <input name="sitioWeb" tabindex="-1" autocomplete="off" /></label>
    </div>

    <p data-estado role="alert" class="rounded-[14px] bg-red-50 px-4 py-3 text-[14px] text-red-800 empty:hidden"></p>

    <button
      type="submit"
      class="inline-flex h-12 w-full items-center justify-center gap-2 rounded-full bg-navy-900 px-6 text-sm font-semibold text-white transition-colors hover:bg-primary-700 disabled:cursor-wait disabled:opacity-70 sm:w-auto"
    >
      <span data-texto-boton>Enviar postulación</span>
    </button>
  </form>

  <!-- Confirmación: reemplaza al formulario al enviarse -->
  <div data-exito hidden tabindex="-1" class="mt-8 rounded-[24px] bg-surface-tint p-8 outline-none">
    <span class="flex size-12 items-center justify-center rounded-full bg-primary-300 text-navy-950">
      <CircleCheck size={22} aria-hidden="true" />
    </span>
    <h3 class="mt-5 text-[22px] font-semibold text-navy-900">¡Recibimos tu postulación!</h3>
    <p class="mt-2 text-[15px] leading-7 text-body">
      Gracias por tu interés en {vacanteTitulo}. Nuestro equipo de Recursos Humanos revisará tu perfil y te contactará si
      avanzas en el proceso.
    </p>
  </div>

  <p class="mt-6 flex flex-wrap items-center gap-2 text-[13px] text-body" data-cms="postulacion.correo">
    <Mail size={14} aria-hidden="true" />
    ¿Dudas sobre la vacante? Escribe a
    <a href={`mailto:${correoRrhh}`} class="font-semibold text-primary-700">{correoRrhh}</a>
  </p>
</section>
