---
import ConstruccionImg from "../assets/Servicios/01-construccion.png";
import RedesHfcImg from "../assets/Servicios/02-HFC.png";
import FibraOpticaImg from "../assets/Servicios/03-fibra.png";

const services = [
  {
    title: "Proyectos RF",
    description:
      "Diseño, implementación y optimización de soluciones de radiofrecuencia para redes de telecomunicaciones.",
    image: ConstruccionImg.src,
    href: "/Servicios/Proyectos-RF",
    className: "md:col-span-7 md:row-span-2",
    featured: true,
  },
  {
    title: "Redes HFC",
    description:
      "Planificación y diseño de soluciones de telecomunicaciones.",
    image: RedesHfcImg.src,
    href: "/Servicios/redes-hfc",
    className: "md:col-span-5",
  },
  {
    title: "Redes Fibra Óptica",
    description:
      "Soluciones en fibra óptica y redes de alta capacidad.",
    image: FibraOpticaImg.src,
    href: "/Servicios/redes-fo",
    className: "md:col-span-5",
  },
];
---

<section
  id="servicios"
  class="
    bg-[#f7f9fb]
    py-20
    font-['Montserrat']
    md:py-28
  "
>
  <div class="mx-auto max-w-[1320px] px-6 md:px-8 lg:px-12">

    <!-- HEADER -->
    <div
      class="
        mb-10
        flex flex-col
        gap-6
        md:flex-row
        md:items-end
        md:justify-between
      "
    >
      <div>
        <div class="mb-4 flex items-center gap-3">
          <span class="h-px w-8 bg-[#087fc1]"></span>

          <span
            class="
              text-[10px]
              font-semibold
              tracking-[0.3em]
              text-[#087fc1]
            "
          >
            NUESTROS SERVICIOS
          </span>
        </div>

        <h2
          class="
            max-w-[650px]
            text-[36px]
            font-semibold
            leading-[1.08]
            tracking-[-0.04em]
            text-[#123d68]

            md:text-[48px]
          "
        >
          Soluciones para cada 
          <span class="text-[#76a5c9] font-bold">
            conexión.
          </span>
        </h2>
      </div>

      <p
        class="
          max-w-[430px]
          text-[12px]
          leading-6
          text-slate-500
          md:text-[13px]
        "
      >
        Diseñamos, construimos y mantenemos infraestructura
        de telecomunicaciones adaptada a las necesidades
        de cada proyecto.
      </p>
    </div>


    <!-- BENTO GRID -->
    <div
      class="
        grid
        auto-rows-[245px]
        grid-cols-1
        gap-3

        md:grid-cols-12
        md:auto-rows-[250px]

        lg:auto-rows-[270px]
      "
    >

      {
        services.map((service) => (

          <a
            href={service.href}
            class:list={[
              `
                group
                relative
                overflow-hidden
                rounded-[24px]
              `,
              service.className,
            ]}
          >

            <!-- IMAGE -->
            <img
              src={service.image}
              alt={service.title}
              loading="lazy"
              class="
                absolute inset-0
                h-full w-full
                object-cover
                transition-transform
                duration-700
                ease-out

                group-hover:scale-[1.04]
              "
            />

            <!-- DARK GRADIENT -->
            <div
              class="
                absolute inset-0
                bg-gradient-to-t
                from-[#071c30]/90
                via-[#0b2c48]/20
                to-transparent
              "
            ></div>


            <!-- NUMBER -->
            <div
              class="
                absolute
                right-5 top-5

                flex h-10 w-10
                items-center justify-center

                rounded-full
                border border-white/30
                bg-white/10
                text-[10px]
                font-medium
                text-white

                backdrop-blur-md
              "
            >
              0{services.indexOf(service) + 1}
            </div>


            <!-- CONTENT -->
            <div
              class="
                absolute
                bottom-0 left-0 right-0
                p-6

                md:p-7
                lg:p-8
              "
            >
              <div
                class="
                  flex
                  items-end
                  justify-between
                  gap-5
                "
              >

                <div>
                  <h3
                    class="
                      text-[20px]
                      font-semibold
                      tracking-[-0.025em]
                      text-white

                      md:text-[22px]

                      lg:text-[24px]
                    "
                  >
                    {service.title}
                  </h3>

                  <p
                    class:list={[
                      `
                        mt-2
                        max-w-[420px]
                        text-[11px]
                        leading-5
                        text-white/75

                        md:text-[12px]
                      `,
                      !service.featured && "lg:max-w-[320px]"
                    ]}
                  >
                    {service.description}
                  </p>
                </div>


                <!-- ARROW -->
                <span
                  class="
                    flex
                    h-11 w-11
                    shrink-0
                    items-center justify-center

                    rounded-full
                    border border-white/40
                    bg-white/10

                    text-lg
                    text-white

                    backdrop-blur-md

                    transition-all
                    duration-300

                    group-hover:rotate-[-35deg]
                    group-hover:bg-white
                    group-hover:text-[#123d68]
                  "
                >
                  ↗
                </span>

              </div>
            </div>

          </a>

        ))
      }

    </div>


    <!-- BOTTOM -->
    <div
      class="
        mt-9
        flex
        justify-center
      "
    >
      <a
        href="/servicios"
        class="
          group
          inline-flex
          h-12
          items-center
          gap-4
          rounded-full
          border border-[#123d68]/20
          bg-white
          px-6
          text-[11px]
          font-semibold
          text-[#123d68]
          no-underline
          transition-all

          hover:border-[#087fc1]
          hover:text-[#087fc1]
        "
      >
        Ver todos los servicios

        <span
          class="
            transition-transform
            duration-300
            group-hover:translate-x-1
          "
        >
          →
        </span>
      </a>
    </div>

  </div>
</section>