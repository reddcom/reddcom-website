---
import ConstruccionImg from "../assets/Servicios/01-construccion.png";
import RedesHfcImg from "../assets/Servicios/02-HFC.png";
import FibraOpticaImg from "../assets/Servicios/03-fibra.png";

import Foto from "./ui/Foto.astro";
import { obtenerPagina, seccion } from "../lib/cms";

/* Servicios de Inicio: el contenido sale del CMS (registro `inicio` → Servicios)
   con estos datos de prueba como respaldo; el tamaño de cada tarjeta, por posición. */
const servicios = seccion(await obtenerPagina("inicio"), "servicios");

const encabezado = servicios.uno("encabezado", "encabezado") ?? {
  etiqueta: "NUESTROS SERVICIOS",
  titulo: "Soluciones para cada",
  destacado: "conexión.",
  descripcion:
    "Diseñamos, construimos y mantenemos infraestructura de telecomunicaciones adaptada a las necesidades de cada proyecto.",
};

// No hay página que liste todos los servicios: por defecto lleva a la primera.
const enlaceTodos = servicios.uno("enlaceTodos", "enlace") ?? { texto: "Ver todos los servicios", url: "/Servicios/redes-hfc" };
const tarjetas = servicios.lista("servicios", "tarjeta") ?? [
  {
    titulo: "Proyectos RF",
    texto: "Diseño, implementación y optimización de soluciones de radiofrecuencia para redes de telecomunicaciones.",
    imagen: { src: ConstruccionImg, alt: "Proyectos RF" },
    url: "/Servicios/Proyectos-RF",
  },
  {
    titulo: "Redes HFC",
    texto: "Planificación y diseño de soluciones de telecomunicaciones.",
    imagen: { src: RedesHfcImg, alt: "Redes HFC" },
    url: "/Servicios/redes-hfc",
  },
  {
    titulo: "Redes Fibra Óptica",
    texto: "Soluciones en fibra óptica y redes de alta capacidad.",
    imagen: { src: FibraOpticaImg, alt: "Redes de fibra óptica" },
    url: "/Servicios/redes-fo",
  },
];

// La primera tarjeta es la grande del bento.
const services = tarjetas.map((tarjeta, indice) => ({
  title: tarjeta.titulo,
  description: tarjeta.texto,
  image: tarjeta.imagen?.src,
  href: tarjeta.url,
  className: indice === 0 ? "md:col-span-7 md:row-span-2" : "md:col-span-5",
  featured: indice === 0,
}));
---

<section
  id="servicios"
  class="
    bg-surface
    py-20
    font-['Montserrat']
    md:py-28
  "
>
  <div class="mx-auto max-w-[1320px] px-6 md:px-8 lg:px-12">

    <!-- HEADER -->
    <div
      data-cms="servicios.encabezado"
      class="
        mb-10
        flex flex-col
        gap-6
        md:flex-row
        md:items-end
        md:justify-between
      "
    >
      <div>
        <div class="mb-4 flex items-center gap-3">
          <span class="h-px w-8 bg-primary-700"></span>

          <span
            class="
              text-[10px]
              font-semibold
              tracking-[0.3em]
              text-primary-700
            "
          >
            {encabezado.etiqueta}
          </span>
        </div>

        <h2
          class="
            max-w-[650px]
            text-[36px]
            font-semibold
            leading-[1.08]
            tracking-[-0.04em]
            text-navy-800

            md:text-[48px]
          "
        >
          {encabezado.titulo}
          <span class="text-[#76a5c9] font-bold">
            {encabezado.destacado}
          </span>
        </h2>
      </div>

      <p
        class="
          max-w-[430px]
          text-[12px]
          leading-6
          text-slate-500
          md:text-[13px]
        "
      >
        {encabezado.descripcion}
      </p>
    </div>


    <!-- BENTO GRID -->
    <div
      data-cms="servicios.servicios"
      class="
        grid
        auto-rows-[245px]
        grid-cols-1
        gap-3

        md:grid-cols-12
        md:auto-rows-[250px]

        lg:auto-rows-[270px]
      "
    >

      {
        services.map((service) => (

          <a
            href={service.href}
            class:list={[
              `
                group
                relative
                overflow-hidden
                rounded-sm
              `,
              service.className,
            ]}
          >

            <!-- IMAGE -->
            {service.image && (
              <Foto
                src={service.image}
                alt={service.title}
                loading="lazy"
                class="
                  absolute inset-0
                  h-full w-full
                  object-cover
                "
              />
            )}

            <!-- DARK GRADIENT -->
            <div
              class="
                absolute inset-0
                bg-gradient-to-t
                from-navy-950/90
                via-[#0b2c48]/20
                to-transparent
              "
            ></div>


            <!-- CONTENT -->
            <div
              class="
                absolute
                bottom-0 left-0 right-0
                p-6

                md:p-7
                lg:p-8
              "
            >
              <div
                class="
                  flex
                  items-end
                  justify-between
                  gap-5
                "
              >

                <div>
                  <h3
                    class="
                      text-[20px]
                      font-semibold
                      tracking-[-0.025em]
                      text-white

                      md:text-[22px]

                      lg:text-[24px]
                    "
                  >
                    {service.title}
                  </h3>

                  <p
                    class:list={[
                      `
                        mt-2
                        max-w-[420px]
                        text-[11px]
                        leading-5
                        text-white/75

                        md:text-[12px]
                      `,
                      !service.featured && "lg:max-w-[320px]"
                    ]}
                  >
                    {service.description}
                  </p>
                </div>


                <!-- ARROW -->
                <span
                  class="
                    inline-flex
                    h-10
                    shrink-0
                    items-center
                    gap-2
                    rounded-sm
                    bg-white
                    px-4
                    text-sm
                    font-semibold
                    text-navy-900

                    transition-colors
                    duration-200

                    group-hover:bg-primary-700
                    group-hover:text-white
                  "
                >
                  Ver servicio
                  <span aria-hidden="true">→</span>
                </span>

              </div>
            </div>

          </a>

        ))
      }

    </div>


    <!-- BOTTOM -->
    <div
      class="
        mt-9
        flex
        justify-center
      "
    >
      <a
        href={enlaceTodos.url}
        data-cms="servicios.enlaceTodos"
        class="
          group
          inline-flex
          h-12
          items-center
          gap-3
          rounded-sm
          border border-navy-800/25
          bg-white
          px-6
          text-sm
          font-semibold
          text-navy-800
          no-underline
          transition-all

          hover:border-primary-700
          hover:text-primary-700
        "
      >
        {enlaceTodos.texto}

        <span
          class="
            transition-transform
            duration-300
            group-hover:translate-x-1
          "
        >
          →
        </span>
      </a>
    </div>

  </div>
</section>