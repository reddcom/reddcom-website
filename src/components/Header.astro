---
import { obtenerPagina, seccion, type ElementoMenu } from "../lib/cms";

/* Barra de navegación. Sale del CMS (Menú principal → Barra de navegación);
   cada campo vacío usa el menú de respaldo de aquí. Un elemento con `hijos`
   es un desplegable; sin ellos, un enlace. */
const menuPrueba: ElementoMenu[] = [
  { texto: "INICIO", url: "/", hijos: [] },
  {
    texto: "NOSOTROS",
    hijos: [
      { texto: "Misión y Visión", url: "/nosotros/mision-vision" },
      { texto: "Nuestra Empresa", url: "/nosotros/nuestra-empresa" },
    ],
  },
  {
    texto: "SERVICIOS",
    hijos: [
      { texto: "Redes HFC", url: "/Servicios/redes-hfc" },
      { texto: "Fibra Óptica", url: "/Servicios/redes-fo" },
      { texto: "Proyectos RF", url: "/Servicios/Proyectos-RF" },
    ],
  },
  {
    texto: "PROYECTOS",
    hijos: [
      { texto: "Reddcom Honduras", url: "/proyectos/Reddcom-Honduras" },
      { texto: "Reddcom Guatemala", url: "/proyectos/Reddcom-Guatemala" },
    ],
  },
  { texto: "OPORTUNIDADES LABORALES", url: "/Oportunidades-Laborales", hijos: [] },
  { texto: "CONTACTO", url: "/contacto", hijos: [] },
];

const barra = seccion(await obtenerPagina("navegacion"), "menu");
const elementos = barra.lista("elementos", "menu") ?? menuPrueba;
const boton = barra.uno("boton", "enlace") ?? { texto: "Contáctanos", url: "/contacto" };
const logo = barra.uno("logo", "imagen") ?? { src: "/logo/reddcom-logo.webp", alt: "Reddcom" };

const claseEnlace =
  "flex items-center whitespace-nowrap py-6 text-[10px] font-medium tracking-[-0.01em] text-[#26394c] no-underline transition-colors duration-200 hover:text-primary-700 xl:text-[11px]";
---

<header id="menu" class="fixed left-0 top-0 z-50 w-full px-4 pt-5 font-['Montserrat'] md:px-8 lg:px-12">
  <nav
    aria-label="Principal"
    class="mx-auto flex h-[72px] max-w-[1320px] items-center justify-between rounded-[50px] border border-white/70 bg-white/95 px-5 shadow-[0_10px_35px_rgba(15,45,70,0.10)] backdrop-blur-xl md:px-7 lg:px-8"
  >
    <a href="/" class="flex shrink-0 items-center" aria-label="Reddcom" data-cms="menu.logo">
      <img src={logo.src} alt={logo.alt || "Reddcom"} class="w-[100px] object-contain lg:w-[140px]" />
    </a>

    <!-- MENÚ DE ESCRITORIO -->
    <ul class="hidden items-center gap-6 lg:flex xl:gap-8" data-cms="menu.elementos">
      {
        elementos.map((item) => (
          <li class="group relative">
            {item.hijos.length > 0 ? (
              <>
                <button type="button" aria-haspopup="true" class={`${claseEnlace} gap-1 border-0 bg-transparent`}>
                  {item.texto}
                  <svg
                    class="h-[11px] w-[11px] transition-transform duration-200 group-focus-within:rotate-180 group-hover:rotate-180"
                    viewBox="0 0 20 20"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path d="M6 8L10 12L14 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>

                <!-- El pt-2 hace de puente para que el hover no se corte -->
                <div class="invisible absolute left-0 top-full z-[999] min-w-[230px] pt-2 opacity-0 transition-all duration-200 group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
                  <ul class="rounded-[14px] border border-navy-900/10 bg-white p-2 shadow-[0_15px_40px_rgba(16,47,77,0.16)]">
                    {item.hijos.map((hijo) => (
                      <li>
                        <a
                          href={hijo.url}
                          class="flex items-center rounded-[10px] px-4 py-3 text-[11px] font-medium text-[#26394c] no-underline transition-colors duration-200 hover:bg-[#f2f8fc] hover:text-primary-700"
                        >
                          {hijo.texto}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </>
            ) : (
              <a href={item.url} class={claseEnlace}>
                {item.texto}
              </a>
            )}
          </li>
        ))
      }
    </ul>

    <a
      href={boton.url}
      data-cms="menu.boton"
      class="hidden h-[42px] items-center gap-2 rounded-sm bg-navy-900 px-5 text-sm font-semibold text-white no-underline transition-colors duration-200 hover:bg-primary-700 xl:flex"
    >
      {boton.texto}
      <span aria-hidden="true">→</span>
    </a>

    <!-- BOTÓN DEL MENÚ MÓVIL -->
    <button
      type="button"
      data-menu-boton
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="menu-movil"
      class="flex h-10 w-10 flex-col items-center justify-center gap-[5px] rounded-full bg-navy-900 lg:hidden"
    >
      <span class="h-[1.5px] w-[18px] bg-white"></span>
      <span class="h-[1.5px] w-[18px] bg-white"></span>
      <span class="h-[1.5px] w-[18px] bg-white"></span>
    </button>
  </nav>

  <!-- MENÚ MÓVIL: lista vertical; los desplegables se abren en su lugar -->
  <div
    id="menu-movil"
    data-menu-panel
    hidden
    class="mx-auto mt-2 max-h-[calc(100dvh-110px)] max-w-[1320px] overflow-y-auto rounded-[24px] border border-navy-900/10 bg-white p-3 shadow-[0_15px_40px_rgba(16,47,77,0.16)] lg:hidden"
  >
    <ul>
      {
        elementos.map((item) => (
          <li class="border-b border-navy-900/10 last:border-b-0">
            {item.hijos.length > 0 ? (
              <details class="group">
                <summary class="flex cursor-pointer list-none items-center justify-between px-3 py-3.5 text-xs font-semibold text-[#26394c] [&::-webkit-details-marker]:hidden">
                  {item.texto}
                  <svg class="h-4 w-4 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path d="M6 8L10 12L14 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </summary>
                <ul class="pb-2">
                  {item.hijos.map((hijo) => (
                    <li>
                      <a href={hijo.url} class="block rounded-[10px] px-5 py-2.5 text-sm text-body no-underline hover:bg-[#f2f8fc] hover:text-primary-700">
                        {hijo.texto}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ) : (
              <a href={item.url} class="block px-3 py-3.5 text-xs font-semibold text-[#26394c] no-underline hover:text-primary-700">
                {item.texto}
              </a>
            )}
          </li>
        ))
      }
    </ul>
    <a
      href={boton.url}
      class="mt-3 flex h-11 items-center justify-center gap-2 rounded-sm bg-navy-900 text-sm font-semibold text-white no-underline hover:bg-primary-700"
    >
      {boton.texto}
      <span aria-hidden="true">→</span>
    </a>
  </div>
</header>

<script>
  /* Abre y cierra el menú móvil. Con las transiciones de Astro el header se
     vuelve a pintar en cada página, así que se enlaza en cada carga. */
  let escuchas: AbortController | undefined;

  function iniciarMenuMovil() {
    // El listener del documento sobrevive a la navegación: se quita el anterior.
    escuchas?.abort();
    escuchas = new AbortController();
    const boton = document.querySelector<HTMLButtonElement>("[data-menu-boton]");
    const panel = document.querySelector<HTMLElement>("[data-menu-panel]");
    if (!boton || !panel) return;

    const alternar = (abierto: boolean) => {
      panel.hidden = !abierto;
      boton.setAttribute("aria-expanded", String(abierto));
      boton.setAttribute("aria-label", abierto ? "Cerrar menú" : "Abrir menú");
    };

    boton.addEventListener("click", () => alternar(panel.hidden));
    document.addEventListener(
      "keydown",
      (evento) => {
        if (evento.key === "Escape") alternar(false);
      },
      { signal: escuchas.signal },
    );
  }

  document.addEventListener("astro:page-load", iniciarMenuMovil);
</script>
