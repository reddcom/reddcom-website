---
import { getImage } from "astro:assets";
import heroImage from "../assets/Landing/reddcom-hero.png";
import { obtenerPagina, seccion } from "../lib/cms";

/* Hero de Inicio: cada campo del CMS (registro `inicio` → Hero) reemplaza
   al texto de prueba solo si tiene contenido. */
const hero = seccion(await obtenerPagina("inicio"), "hero");
const encabezado = hero.uno("encabezado", "encabezado") ?? {
  etiqueta: "TELECOMUNICACIONES QUE CONECTAN",
  titulo: "Infraestructura para un mejor",
  destacado: "mañana.",
  descripcion:
    "Diseño, construcción y mantenimiento de redes telefónicas y soluciones de telecomunicaciones que conectan personas, empresas y comunidades.",
};
// Fondo CSS: no pasa por <Image>, así que getImage entrega el respaldo local en WebP.
const imagen = hero.uno("imagen", "imagen")?.src ?? (await getImage({ src: heroImage })).src;
const botonPrincipal = hero.uno("botonPrincipal", "enlace") ?? { texto: "Conoce nuestros servicios", url: "#servicios" };
const botonSecundario = hero.uno("botonSecundario", "enlace") ?? { texto: "Conoce Reddcom", url: "/nosotros/nuestra-empresa" };
const textoLateral = hero.lista("textoLateral", "texto") ?? ["MÁS CONEXIONES", "MÁS OPORTUNIDADES"];
---

<section
  id="hero"
  data-cms="hero.imagen"
  class="
    relative
    min-h-[760px]
    overflow-hidden
    bg-cover
    bg-[position:62%_center]
    md:bg-[position:64%_center]
    lg:min-h-[780px]
    lg:bg-[position:66%_center]
  "
  style={`background-image: url('${imagen}')`}
>
  <!-- DEGRADADO IZQUIERDO -->
  <div
    class="
      absolute inset-0
      bg-[linear-gradient(90deg,rgba(247,250,252,0.98)_0%,rgba(247,250,252,0.93)_24%,rgba(247,250,252,0.65)_42%,rgba(247,250,252,0.15)_59%,rgba(247,250,252,0)_72%)]
    "
  ></div>

  <!-- VELO MÓVIL: en pantallas angostas el texto cae sobre la foto -->
  <div class="absolute inset-0 bg-surface/80 md:hidden"></div>

  <!-- DEGRADADO SUPERIOR -->
  <div
    class="
      absolute inset-x-0 top-0 h-48
      bg-gradient-to-b
      from-white/30
      to-transparent
    "
  ></div>

  <!-- CONTENIDO -->
  <div
    class="
      relative z-10
      mx-auto
      flex min-h-[760px]
      max-w-[1320px]
      items-center
      px-6
      pb-20
      pt-36

      md:px-8

      lg:min-h-[780px]
      lg:px-12
      lg:pt-40
    "
  >
    <div class="max-w-[610px]" data-cms="hero.encabezado">

      <!-- LABEL -->
      <div class="mb-6 flex items-center gap-4">
        <span
          class="
            h-px w-9
            bg-primary-700
          "
        ></span>

        <span
          class="
            font-['Montserrat']
            text-[10px]
            font-semibold
            tracking-[0.32em]
            text-[#39709b]

            md:text-[11px]
          "
        >
          {encabezado.etiqueta}
        </span>
      </div>

      <!-- TITULO -->
      <h1
        class="
          max-w-[600px]
          font-['Montserrat']
          text-[48px]
          font-semibold
          leading-[1.02]
          tracking-[-0.045em]
          text-navy-800

          sm:text-[58px]
          md:text-[66px]
          lg:text-[72px]
        "
      >
        {encabezado.titulo}

        <span
          class="
            block
            font-medium
            text-[#72a4c9]
          "
        >
          {encabezado.destacado}
        </span>
      </h1>

      <!-- DESCRIPCIÓN -->
      <p
        class="
          mt-7
          max-w-[520px]
          font-['Montserrat']
          text-[13px]
          font-normal
          leading-7
          text-[#405a70]

          md:text-[14px]
        "
      >
        {encabezado.descripcion}
      </p>

      <!-- BOTONES -->
      <div
        class="
          mt-9
          flex
          flex-col
          gap-3

          sm:flex-row
        "
      >
        <!-- PRINCIPAL -->
        <a
          href={botonPrincipal.url}
          data-cms="hero.botonPrincipal"
          class="
            group
            inline-flex
            h-12
            items-center
            justify-center
            gap-3
            rounded-sm
            bg-[#0b4778]
            px-6
            font-['Montserrat']
            text-sm
            font-semibold
            text-white
            no-underline
            transition-colors
            duration-200

            hover:bg-primary-700
          "
        >
          {botonPrincipal.texto}

          <span
            aria-hidden="true"
            class="
              transition-transform
              duration-200

              group-hover:translate-x-0.5
            "
          >
            →
          </span>
        </a>

        <!-- SECUNDARIO -->
        <a
          href={botonSecundario.url}
          data-cms="hero.botonSecundario"
          class="
            inline-flex
            h-12
            items-center
            justify-center
            rounded-sm
            border
            border-[#173f64]/40
            bg-white
            px-6
            font-['Montserrat']
            text-sm
            font-semibold
            text-[#173f64]
            no-underline
            transition-colors
            duration-200

            hover:border-primary-700
            hover:text-primary-700
          "
        >
          {botonSecundario.texto}
        </a>
      </div>
    </div>

    <!-- TEXTO LATERAL -->
    <div
      data-cms="hero.textoLateral"
      class="
        absolute
        right-12
        top-1/2
        hidden
        -translate-y-1/2
        flex-col
        font-['Montserrat']
        text-[9px]
        font-semibold
        leading-[1.9]
        tracking-[0.3em]
        text-[#315f84]/70

        xl:flex
      "
    >
      {textoLateral.map((linea) => <span>{linea}</span>)}

      <span
        class="
          mt-4
          h-px w-10
          bg-primary-700/70
        "
      ></span>
    </div>

    <!-- BOTTOM -->
    <div
      class="
        absolute
        bottom-8
        left-6
        right-6
        hidden
        items-end
        justify-end

        md:flex
        md:left-8
        md:right-8

        lg:left-12
        lg:right-12
      "
    >
      <!-- SCROLL -->
      <a
        href="#servicios"
        class="
          group
          flex
          items-center
          gap-3
          font-['Montserrat']
          text-[9px]
          font-medium
          text-white
          no-underline
        "
      >
        <span
          class="
            flex
            h-9 w-9
            items-center
            justify-center
            rounded-sm
            border border-white/70
            transition-colors
            group-hover:bg-white
            group-hover:text-navy-800
          "
        >
          ↓
        </span>

        Explorar
      </a>
    </div>
  </div>
</section>